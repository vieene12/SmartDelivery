<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - SmartDelivery</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <script>
        (function () {
            const savedTheme = localStorage.getItem('theme');
            const systemPrefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
            if (savedTheme === 'dark' || (!savedTheme && systemPrefersDark)) {
                document.documentElement.classList.add('dark-mode');
                document.addEventListener('DOMContentLoaded', () => {
                    document.body.classList.add('dark-mode');
                });
            }
        })();
    </script>
</head>
<body>
    <header class="navbar">
        <div style="display: flex; align-items: center; gap: 2.5rem;">
            <a asp-controller="Home" asp-action="Index" style="text-decoration: none; color: inherit; display: flex; align-items: center; gap: 0.75rem;">
                <svg class="logo-svg" viewBox="0 0 32 32" fill="none" xmlns="http://www.w3.org/2000/svg" style="width: 36px; height: 36px; filter: drop-shadow(0 2px 8px rgba(37, 99, 235, 0.25));">
                    <path d="M16 2L3 9.5v13L16 30l13-7.5v-13L16 2z" fill="var(--primary)" fill-opacity="0.15" stroke="var(--primary)" stroke-width="2" stroke-linejoin="round" />
                    <path d="M16 2L3 9.5M16 2l13 7.5M16 2v28M3 9.5l13 7.5M29 9.5l-13 7.5" stroke="var(--primary)" stroke-width="1.5" stroke-linejoin="round" opacity="0.6" />
                    <path d="M11 12.5h5.5l-3.5 3.5h5L14 20" stroke="var(--secondary)" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
                <span class="brand-name" style="font-size: 1.45rem; font-weight: 850; color: var(--primary); letter-spacing: -0.04em;">SmartDelivery</span>
            </a>

            <nav class="nav-links">
                <a asp-controller="Home" asp-action="Index" class="nav-item active">Trang Chủ</a>
                <div class="dropdown">
                    <a class="nav-item dropdown-toggle" id="pricingDropdown" style="display: inline-flex; align-items: center; gap: 0.25rem; cursor: pointer;">
                        Bảng giá <i class="fas fa-caret-down" style="font-size: 0.8rem; margin-left: 0.2rem;"></i>
                    </a>
                    <div class="dropdown-menu">
                        <a class="dropdown-item" asp-controller="Home" asp-action="Pricing" asp-route-tab="hcm-hn">
                            🏢 Hà Nội – Thành phố Hồ Chí Minh
                        </a>
                        <div class="dropdown-divider"></div>
                        <a class="dropdown-item" asp-controller="Home" asp-action="Pricing" asp-route-tab="others">
                            🗺️ Tỉnh – Thành phố còn lại
                        </a>
                    </div>
                </div>

                @if (User.IsInRole("Admin"))
                {
                    <a class="nav-item" asp-controller="Admin" asp-action="Staff">Nhân sự</a>
                    <a class="nav-item" asp-controller="Admin" asp-action="Warehouses">Kho bãi</a>
                    <a class="nav-item" asp-controller="Admin" asp-action="AuditLogs">Nhật ký</a>
                    <a class="nav-item" asp-controller="Admin" asp-action="OrderReport"><i class="fas fa-chart-bar" style="margin-right:0.25rem;font-size:0.85rem;"></i>Báo cáo</a>
                }

                @if (User.IsInRole("WarehouseStaff") || User.IsInRole("Admin"))
                {
                    <a class="nav-item" asp-controller="Warehouse" asp-action="Inventory">Kho hàng</a>
                }

                @if (User.IsInRole("Shipper") || User.IsInRole("Admin"))
                {
                    <a class="nav-item" asp-controller="Shipper" asp-action="MyDeliveries">Vận chuyển</a>
                }

                @if (User.IsInRole("Customer") || User.IsInRole("Admin"))
                {
                    <a class="nav-item" asp-controller="Customer" asp-action="Orders">Đơn hàng của tôi</a>
                }
            </nav>
        </div>

        <div style="display: flex; align-items: center; gap: 1.25rem;">
            <button id="theme-toggle" class="theme-toggle-btn" title="Chuyển chế độ tối/sáng">
                <i class="fas fa-moon"></i>
            </button>
            <partial name="_LoginPartial" />
            <a asp-controller="Customer" asp-action="CreateOrder" class="btn-premium">
                <i class="fas fa-plus"></i> Tạo đơn mới
            </a>
        </div>
    </header>

    <main class="main-container">
        @RenderBody()
    </main>

    <footer class="footer-section">
        <div class="footer-grid">
            <div class="footer-column">
                <div style="display: flex; align-items: center; gap: 0.65rem; margin-bottom: 1.25rem;">
                    <svg class="logo-svg" viewBox="0 0 32 32" fill="none" xmlns="http://www.w3.org/2000/svg" style="width: 28px; height: 28px;">
                        <path d="M16 2L3 9.5v13L16 30l13-7.5v-13L16 2z" fill="var(--primary)" fill-opacity="0.15" stroke="var(--primary)" stroke-width="2" stroke-linejoin="round" />
                        <path d="M16 2L3 9.5M16 2l13 7.5M16 2v28M3 9.5l13 7.5M29 9.5l-13 7.5" stroke="var(--primary)" stroke-width="1.5" stroke-linejoin="round" opacity="0.6" />
                        <path d="M11 12.5h5.5l-3.5 3.5h5L14 20" stroke="var(--secondary)" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" />
                    </svg>
                    <span style="font-size: 1.2rem; font-weight: 850; color: white; letter-spacing: -0.04em;">SmartDelivery</span>
                </div>
                <p>Hệ thống Quản lý Giao nhận Vận tải Thông minh số 1 Việt Nam. Tối ưu quy trình vận tải bằng công nghệ tự động hóa hiện đại bậc nhất.</p>
                <div class="footer-socials">
                    <a href="#" class="social-icon"><i class="fab fa-facebook-f"></i></a>
                    <a href="#" class="social-icon"><i class="fab fa-twitter"></i></a>
                    <a href="#" class="social-icon"><i class="fab fa-linkedin-in"></i></a>
                    <a href="#" class="social-icon"><i class="fab fa-youtube"></i></a>
                </div>
            </div>
            <div class="footer-column">
                <h4>Dịch Vụ</h4>
                <ul class="footer-links">
                    <li><a href="#">Giao hàng siêu tốc</a></li>
                    <li><a href="#">Giao hàng tiết kiệm</a></li>
                    <li><a href="#">Vận chuyển đường không</a></li>
                    <li><a href="#">Giải pháp doanh nghiệp</a></li>
                </ul>
            </div>
            <div class="footer-column">
                <h4>Hệ Thống</h4>
                <ul class="footer-links">
                    <li><a asp-controller="Home" asp-action="Index">Trang chủ</a></li>
                    <li><a asp-controller="Home" asp-action="Pricing">Bảng giá cước</a></li>
                    <li><a asp-controller="Customer" asp-action="CreateOrder">Tạo đơn mới</a></li>
                    <li><a href="#">Tra cứu bưu gửi</a></li>
                </ul>
            </div>
            <div class="footer-column">
                <h4>Liên Hệ</h4>
                <p style="margin-bottom: 0.5rem;"><i class="fas fa-map-marker-alt" style="color: var(--primary); margin-right: 0.5rem;"></i> Quận 1, TP. Hồ Chí Minh</p>
                <p style="margin-bottom: 0.5rem;"><i class="fas fa-phone-alt" style="color: var(--primary); margin-right: 0.5rem;"></i> Hotline: 1900 6868</p>
                <p><i class="fas fa-envelope" style="color: var(--primary); margin-right: 0.5rem;"></i> hotro@smartdelivery.vn</p>
            </div>
        </div>
        <div class="footer-bottom">
            <p>&copy; @DateTime.Now.Year SmartDelivery. Tất cả các quyền được bảo lưu.</p>
            <div style="display: flex; gap: 1.5rem;">
                <a href="#" style="color: #64748b; hover: color: white;">Điều khoản bảo mật</a>
                <a href="#" style="color: #64748b; hover: color: white;">Điều kiện sử dụng</a>
            </div>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
