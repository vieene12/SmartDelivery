@model SDMS.Models.DonHang
@{
    ViewData["Title"] = "Tạo đơn hàng mới";
}

<style>
    /* Ocean Tech Theme Variables */
    :root {
        --vp-red: #2563eb;
        --vp-red-hover: #1d4ed8;
        --vp-bg-light: var(--bg-secondary, #f8fafc);
        --vp-text-dark: var(--text-main, #0f172a);
        --vp-text-muted: var(--text-muted, #64748b);
        --vp-border: var(--border-color, rgba(226, 232, 240, 0.8));
        --vp-shadow-card: 0 10px 30px -10px rgba(15, 23, 42, 0.04), 0 1px 3px rgba(15, 23, 42, 0.02);
        --vp-shadow-input: 0 1px 2px rgba(0, 0, 0, 0.02);
    }

    .order-container {
        max-width: 1450px;
        margin: 0 auto;
        padding: 1.25rem 1.75rem;
        padding-bottom: 140px; /* Space for sticky bar */
        font-family: 'Plus Jakarta Sans', 'Inter', system-ui, -apple-system, sans-serif;
        color: var(--vp-text-dark);
        background-color: var(--bg-color, #F8FAFC);
    }

    /* Back Header */
    .order-header-bar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 1.25rem;
        background: var(--card-bg, rgba(255, 255, 255, 0.85));
        backdrop-filter: blur(12px);
        -webkit-backdrop-filter: blur(12px);
        padding: 0.85rem 1.5rem;
        border-radius: 12px;
        box-shadow: var(--vp-shadow-card);
        border: 1px solid var(--vp-border);
    }

    .back-btn {
        background: transparent;
        border: none;
        color: var(--vp-text-dark);
        font-size: 1.15rem;
        cursor: pointer;
        display: flex;
        align-items: center;
        gap: 0.5rem;
        text-decoration: none;
        font-weight: 800;
        transition: transform 0.2s cubic-bezier(0.4, 0, 0.2, 1);
    }

    .back-btn:hover {
        transform: translateX(-4px);
        color: var(--vp-red);
    }

    /* Form Layout Grid */
    .form-grid {
        display: grid;
        grid-template-columns: 1.1fr 1fr;
        gap: 1.5rem;
    }

    @@media (max-width: 1024px) {
        .form-grid {
            grid-template-columns: 1fr;
            gap: 1.25rem;
        }
    }

    /* Card Panels - Upgraded to Premium Glassmorphism */
    .premium-card {
        background: var(--card-bg, rgba(255, 255, 255, 0.85));
        backdrop-filter: blur(16px);
        -webkit-backdrop-filter: blur(16px);
        border-radius: 12px;
        padding: 1.5rem;
        box-shadow: var(--vp-shadow-card);
        border: 1px solid var(--vp-border);
        margin-bottom: 1.25rem;
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    }

    .premium-card:hover {
        transform: translateY(-2px);
        box-shadow: 0 20px 40px -15px rgba(37, 99, 235, 0.05), 0 1px 3px rgba(37, 99, 235, 0.02);
        border-color: rgba(37, 99, 235, 0.2);
    }

    .card-title {
        font-size: 0.925rem;
        font-weight: 800;
        margin-top: 0;
        margin-bottom: 1.25rem;
        display: flex;
        align-items: center;
        justify-content: space-between;
        color: var(--vp-text-dark);
        border-bottom: 1.5px solid var(--border-color, #F1F5F9);
        padding-bottom: 0.75rem;
        text-transform: uppercase;
        letter-spacing: 0.75px;
    }

    .card-title-left {
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }

    .card-title-left i {
        font-size: 1.15rem;
        color: var(--vp-red);
    }

    /* Premium Segmented Radio selectors style */
    .radio-group-custom {
        display: flex;
        gap: 0.75rem;
        margin-bottom: 1rem;
        align-items: center;
        width: 100%;
    }

    .radio-label-custom {
        flex: 1;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 0.5rem;
        font-size: 0.825rem;
        font-weight: 700;
        color: #475569;
        background: rgba(248, 250, 252, 0.6);
        border: 1.5px solid #E2E8F0;
        border-radius: 8px;
        padding: 0.65rem 0.85rem;
        cursor: pointer;
        user-select: none;
        transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
        text-align: center;
    }

    .radio-label-custom:hover {
        background: #F1F5F9;
        border-color: #CBD5E1;
        color: #1E293B;
    }

    .radio-label-custom input[type="radio"] {
        appearance: none;
        -webkit-appearance: none;
        background-color: #fff;
        margin: 0;
        font: inherit;
        color: var(--vp-red);
        width: 1.15em;
        height: 1.15em;
        border: 1.5px solid #CBD5E1;
        border-radius: 50%;
        transform: translateY(-0.05em);
        display: grid;
        place-content: center;
        transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
    }

    .radio-label-custom input[type="radio"]::before {
        content: "";
        width: 0.55em;
        height: 0.55em;
        border-radius: 50%;
        transform: scale(0);
        transition: 120ms transform ease-in-out;
        background-color: currentColor;
    }

    .radio-label-custom input[type="radio"]:checked::before {
        transform: scale(1);
    }

    .radio-label-custom:has(input[type="radio"]:checked) {
        background: rgba(59, 130, 246, 0.07);
        border-color: var(--vp-red);
        color: var(--vp-red);
    }

    /* Standard Label and Inputs */
    .form-group-custom {
        margin-bottom: 1rem;
    }

    .form-label-custom {
        display: block;
        font-size: 0.8rem;
        font-weight: 750;
        color: var(--vp-text-dark);
        margin-bottom: 0.45rem;
        letter-spacing: 0.2px;
    }

    .input-wrapper-custom {
        display: flex;
        align-items: center;
        background: var(--card-bg, white);
        border: 1.5px solid var(--border-color, #E2E8F0);
        border-radius: 8px;
        padding: 0.15rem 0.75rem;
        transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1);
        box-shadow: var(--vp-shadow-input);
    }

    .input-wrapper-custom:focus-within {
        border-color: var(--vp-red);
        box-shadow: 0 0 0 4px rgba(37, 99, 235, 0.12);
    }

    .input-field-custom {
        flex: 1;
        border: none;
        background: transparent;
        padding: 0.625rem 0;
        font-size: 0.875rem;
        font-weight: 600;
        color: var(--vp-text-dark);
        outline: none;
        width: 100%;
    }

    .input-field-custom::placeholder {
        color: var(--text-light, #94A3B8);
        font-weight: 500;
    }

    /* Select wrappers */
    .select-custom-wrapper {
        background: var(--card-bg, white);
        border: 1.5px solid var(--border-color, #E2E8F0);
        border-radius: 8px;
        padding: 0.15rem 0.75rem;
        box-shadow: var(--vp-shadow-input);
        position: relative;
        transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1);
    }

    .select-custom-wrapper:focus-within {
        border-color: var(--vp-red);
        box-shadow: 0 0 0 4px rgba(37, 99, 235, 0.12);
    }

    .select-custom-wrapper select {
        width: 100%;
        border: none;
        background: transparent;
        font-size: 0.875rem;
        font-weight: 600;
        color: var(--vp-text-dark);
        outline: none;
        cursor: pointer;
        padding: 0.625rem 0;
        -webkit-appearance: none;
        -moz-appearance: none;
        appearance: none;
    }

    .select-custom-wrapper select option {
        background: var(--card-bg, white);
        color: var(--vp-text-dark);
    }

    .select-custom-wrapper::after {
        content: '\f078';
        font-family: 'Font Awesome 6 Free';
        font-weight: 900;
        position: absolute;
        right: 0.9rem;
        top: 50%;
        transform: translateY(-50%);
        color: var(--vp-text-muted);
        font-size: 0.75rem;
        pointer-events: none;
    }

    /* Address Select dropdowns row */
    .dropdown-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 0.75rem;
        margin-bottom: 0.75rem;
    }

    /* Premium Checkbox Chips style */
    .checkbox-grid-3col {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 0.5rem;
        margin-bottom: 1rem;
    }

    .checkbox-label-custom {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 0.45rem;
        font-size: 0.8rem;
        font-weight: 700;
        color: #475569;
        background: rgba(248, 250, 252, 0.6);
        border: 1.5px solid #E2E8F0;
        border-radius: 8px;
        padding: 0.55rem 0.25rem;
        cursor: pointer;
        user-select: none;
        transition: all 0.2s ease;
        text-align: center;
    }

    .checkbox-label-custom:hover {
        background: #F1F5F9;
        border-color: #CBD5E1;
        color: #1E293B;
    }

    .checkbox-label-custom input[type="checkbox"] {
        appearance: none;
        -webkit-appearance: none;
        background-color: #fff;
        margin: 0;
        font: inherit;
        color: var(--vp-red);
        width: 1.15em;
        height: 1.15em;
        border: 1.5px solid #CBD5E1;
        border-radius: 4px;
        display: grid;
        place-content: center;
        transition: all 0.2s ease;
    }

    .checkbox-label-custom input[type="checkbox"]::before {
        content: "\f00c";
        font-family: "Font Awesome 6 Free";
        font-weight: 900;
        font-size: 0.65rem;
        color: white;
        transform: scale(0);
        transition: 120ms transform ease-in-out;
    }

    .checkbox-label-custom input[type="checkbox"]:checked {
        background-color: var(--vp-red);
        border-color: var(--vp-red);
    }

    .checkbox-label-custom input[type="checkbox"]:checked::before {
        transform: scale(1);
    }

    .checkbox-label-custom:has(input[type="checkbox"]:checked) {
        background: rgba(59, 130, 246, 0.05);
        border-color: var(--vp-red);
        color: var(--vp-red);
    }

    /* Inline Goods Add Form */
    .goods-form-card {
        background: rgba(248, 250, 252, 0.6);
        border: 1.5px dashed rgba(59, 130, 246, 0.25);
        border-radius: 10px;
        padding: 1.25rem;
        margin-bottom: 1.25rem;
        transition: all 0.3s ease;
    }

    .goods-form-card:hover {
        border-color: rgba(59, 130, 246, 0.5);
        background: rgba(248, 250, 252, 0.9);
    }

    .goods-inline-row {
        display: grid;
        grid-template-columns: 80px 1.2fr 1fr;
        gap: 0.5rem;
        margin-top: 0.5rem;
    }

    .btn-add-goods {
        width: 100%;
        background: var(--card-bg, white);
        border: 1.5px solid var(--vp-red);
        color: var(--vp-red);
        border-radius: 8px;
        padding: 0.65rem;
        font-weight: 800;
        font-size: 0.85rem;
        cursor: pointer;
        transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 0.4rem;
        margin-top: 0.75rem;
    }

    .btn-add-goods:hover {
        background: rgba(37, 99, 235, 0.06);
        box-shadow: 0 4px 12px rgba(37, 99, 235, 0.12);
        transform: translateY(-1px);
    }

    .added-product-row {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 0.85rem;
        border-radius: 8px;
        background: rgba(248, 250, 252, 0.7);
        border: 1px solid var(--vp-border);
        margin-bottom: 0.5rem;
        font-size: 0.85rem;
        transition: border-color 0.2s ease;
    }

    .added-product-row:hover {
        border-color: #3b82f6;
    }

    .prod-details h4 {
        margin: 0 0 0.15rem 0;
        font-size: 0.9rem;
        font-weight: 700;
    }

    .prod-details p {
        margin: 0;
        color: var(--vp-text-muted);
        font-weight: 550;
    }

    .qty-counter {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        background: var(--card-bg, white);
        border: 1px solid var(--vp-border);
        border-radius: 6px;
        padding: 0.2rem 0.5rem;
    }

    .counter-btn {
        background: transparent;
        border: none;
        font-weight: 800;
        cursor: pointer;
        width: 20px;
        height: 20px;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: color 0.2s;
    }

    .counter-btn:hover {
        color: var(--vp-red);
    }

    .counter-val {
        font-weight: 700;
        min-width: 15px;
        text-align: center;
    }

    /* Fixed Sticky Floating Bottom Bar - Upgraded to Premium Float Style */
    .sticky-bottom-bar {
        position: fixed;
        bottom: 1.25rem;
        left: 50%;
        transform: translateX(-50%);
        width: calc(100% - 3.5rem);
        max-width: 1400px;
        background: rgba(255, 255, 255, 0.85);
        backdrop-filter: blur(20px);
        -webkit-backdrop-filter: blur(20px);
        border: 1.5px solid var(--border-color, var(--vp-border));
        border-radius: 16px;
        padding: 0.9rem 2.25rem;
        z-index: 1000;
        box-shadow: 0 20px 40px -10px rgba(15, 23, 42, 0.12), 0 1px 3px rgba(15, 23, 42, 0.04);
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    }

    .sticky-bottom-bar:hover {
        box-shadow: 0 30px 60px -15px rgba(15, 23, 42, 0.18);
        border-color: rgba(37, 99, 235, 0.25);
    }

    .sticky-content {
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .sticky-summary-block {
        display: flex;
        gap: 2rem;
    }

    .sticky-summary-item {
        display: flex;
        flex-direction: column;
        gap: 0.15rem;
    }

    .sticky-summary-lbl {
        font-size: 0.75rem;
        font-weight: 700;
        color: var(--vp-text-muted);
        text-transform: uppercase;
        letter-spacing: 0.75px;
    }

    .sticky-summary-val {
        font-size: 1.35rem;
        font-weight: 900;
        color: var(--vp-red);
        letter-spacing: -0.2px;
    }

    .sticky-actions-block {
        display: flex;
        align-items: center;
        gap: 1.5rem;
    }

    .checkbox-agreement {
        display: flex;
        align-items: center;
        gap: 0.45rem;
        font-size: 0.825rem;
        font-weight: 600;
        cursor: pointer;
    }

    .checkbox-agreement input {
        accent-color: var(--vp-red);
        width: 16px;
        height: 16px;
    }

    .btn-create-order {
        background: var(--vp-red);
        color: white;
        border: none;
        padding: 0.8rem 2.5rem;
        border-radius: 8px;
        font-weight: 800;
        font-size: 0.925rem;
        cursor: pointer;
        box-shadow: 0 8px 20px -6px rgba(37, 99, 235, 0.4);
        transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1);
        position: relative;
        overflow: hidden;
    }

    .btn-create-order:hover {
        background: var(--vp-red-hover);
        transform: translateY(-2px);
        box-shadow: 0 12px 24px -6px rgba(37, 99, 235, 0.6);
    }

    .btn-create-order:active {
        transform: translateY(0);
    }

    .btn-draft-custom {
        background: #64748B;
        color: white;
        border: none;
        padding: 0.8rem 1.75rem;
        border-radius: 8px;
        font-weight: 800;
        font-size: 0.925rem;
        cursor: pointer;
        transition: all 0.2s;
    }

    .btn-draft-custom:hover {
        background: #475569;
        transform: translateY(-1px);
    }

    .btn-reset-custom {
        background: #E2E8F0;
        color: #334155;
        border: none;
        padding: 0.8rem 1.5rem;
        border-radius: 8px;
        font-weight: 800;
        font-size: 0.925rem;
        cursor: pointer;
        transition: all 0.2s;
    }

    .btn-reset-custom:hover {
        background: #CBD5E1;
        transform: translateY(-1px);
    }

    /* Premium Catalog Modal Styling */
    .modal-overlay-custom {
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background: rgba(15, 23, 42, 0.45);
        backdrop-filter: blur(8px);
        -webkit-backdrop-filter: blur(8px);
        z-index: 2000;
        display: none;
        align-items: center;
        justify-content: center;
        padding: 1.5rem;
    }

    .modal-content-custom {
        background: var(--card-bg, rgba(255, 255, 255, 0.9));
        backdrop-filter: blur(20px);
        -webkit-backdrop-filter: blur(20px);
        border-radius: 16px;
        width: 100%;
        max-width: 620px;
        box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.25);
        border: 1px solid var(--vp-border);
        overflow: hidden;
        display: flex;
        flex-direction: column;
        max-height: 80vh;
        animation: modalFadeIn 0.25s cubic-bezier(0.4, 0, 0.2, 1);
    }

    @@keyframes modalFadeIn {
        from { transform: scale(0.96); opacity: 0; }
        to { transform: scale(1); opacity: 1; }
    }

    .modal-header-custom {
        padding: 1.25rem 1.5rem;
        border-bottom: 1.5px solid var(--border-color, #F1F5F9);
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .modal-title-custom {
        font-size: 1rem;
        font-weight: 850;
        color: var(--vp-text-dark);
        text-transform: uppercase;
        letter-spacing: 0.5px;
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }

    .modal-title-custom i {
        color: var(--vp-red);
    }

    .modal-close-btn {
        background: transparent;
        border: none;
        font-size: 1.25rem;
        color: var(--text-light, #94A3B8);
        cursor: pointer;
        transition: color 0.2s;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .modal-close-btn:hover {
        color: var(--vp-red);
    }

    .modal-body-custom {
        padding: 1.25rem 1.5rem;
        overflow-y: auto;
        flex: 1;
        background: var(--bg-secondary, #F8FAFC);
    }

    .modal-search-wrapper {
        margin-bottom: 1.25rem;
        position: sticky;
        top: 0;
        z-index: 10;
        background: var(--bg-secondary, #F8FAFC);
        padding-bottom: 0.5rem;
    }

    .catalog-goods-grid {
        display: flex;
        flex-direction: column;
        gap: 0.75rem;
    }

    .catalog-item-card {
        background: var(--card-bg, white);
        border: 1.5px solid var(--vp-border);
        border-radius: 8px;
        padding: 1rem;
        transition: all 0.2s;
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 1rem;
    }

    .catalog-item-card:hover {
        border-color: var(--vp-red);
        box-shadow: 0 4px 12px rgba(37, 99, 235, 0.08);
        transform: translateY(-1px);
    }

    .catalog-item-info {
        flex: 1;
    }

    .catalog-item-info h4 {
        margin: 0 0 0.25rem 0;
        font-size: 0.9rem;
        font-weight: 750;
        color: var(--vp-text-dark);
    }

    .catalog-item-info p {
        margin: 0 0 0.25rem 0;
        font-size: 0.8rem;
        color: var(--vp-text-muted);
        font-weight: 550;
    }

    .catalog-item-info .catalog-tag {
        display: inline-block;
        background: var(--bg-secondary, #F1F5F9);
        color: var(--text-muted, #475569);
        font-size: 0.7rem;
        font-weight: 700;
        padding: 0.15rem 0.4rem;
        border-radius: 4px;
        text-transform: uppercase;
    }

    .catalog-item-actions {
        display: flex;
        gap: 0.4rem;
    }

    .btn-catalog-select {
        background: var(--card-bg, white);
        border: 1.5px solid var(--border-color, #CBD5E1);
        color: var(--text-muted, #475569);
        padding: 0.45rem 0.85rem;
        border-radius: 6px;
        font-weight: 700;
        font-size: 0.775rem;
        cursor: pointer;
        transition: all 0.2s;
    }

    .btn-catalog-select:hover {
        border-color: var(--vp-red);
        color: var(--vp-red);
        background: rgba(37, 99, 235, 0.04);
    }

    .btn-catalog-add {
        background: var(--vp-red);
        border: none;
        color: white;
        padding: 0.45rem 0.85rem;
        border-radius: 6px;
        font-weight: 700;
        font-size: 0.775rem;
        cursor: pointer;
        transition: all 0.2s;
    }

    .btn-catalog-add:hover {
        background: var(--vp-red-hover);
        box-shadow: 0 2px 8px rgba(227, 6, 19, 0.15);
    }
</style>

<div class="order-container">
    <!-- Header -->
    <div class="order-header-bar">
        <a asp-action="Orders" class="back-btn">
            <i class="fas fa-chevron-left" style="font-size: 0.9rem;"></i> Tạo đơn
        </a>
        <div style="font-size: 0.8rem; font-weight: 600; color: var(--vp-text-muted);">
            Lưu ý: (*) Là các trường bắt buộc nhập
        </div>
    </div>

    <!-- Main Redesigned Form matching screenshot -->
    <form id="create-order-form" asp-action="CreateOrder" method="post">
        @Html.AntiForgeryToken()
        
        <!-- Address elements combined in background -->
        <input type="hidden" asp-for="DiaChiNguoiNhan" id="full-address-hidden" />
        <input type="hidden" asp-for="TongKhoiLuong" id="total-weight-hidden" />
        <input type="hidden" asp-for="HinhThucThanhToan" id="payment-method-hidden" value="COD" />

        <div class="form-grid">
            
            <!-- LEFT COLUMN: SENDER & RECIPIENT -->
            <div>
                <!-- CARD 1: NGƯỜI GỬI -->
                <div class="premium-card">
                    <div class="card-title">
                        <div class="card-title-left">
                            <i class="fas fa-circle-chevron-right"></i> Người gửi
                        </div>
