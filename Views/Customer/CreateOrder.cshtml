                            </div>
                            <div style="font-size: 1rem; font-weight: 850; color: var(--vp-red);" id="pricing-express-fee">20.000 đ</div>
                        </div>
                    </div>

                    <!-- Khuyến mại đã loại bỏ theo yêu cầu của người dùng -->
                </div>
            </div>

            <!-- RIGHT COLUMN: GOODS INFORMATION -->
            <div>
                <!-- CARD 4: THÔNG TIN HÀNG HÓA -->
                <div class="premium-card">
                    <div class="card-title">
                        <div class="card-title-left">
                            <i class="fas fa-circle-chevron-right"></i> Thông tin hàng hóa
                        </div>
                        <a href="javascript:void(0)" onclick="openCatalogModal()" style="font-size: 0.8rem; color: var(--vp-red); font-weight: 700; text-decoration: none; text-transform: none;">
                            Quản lý danh sách hàng hóa &rarr;
                        </a>
                    </div>

                    <!-- Loại hàng hóa -->
                    <div class="form-group-custom" style="margin-bottom: 1rem;">
                        <div class="form-label-custom">Loại hàng hóa*</div>
                        <div class="radio-group-custom">
                            <label class="radio-label-custom">
                                <input type="radio" name="cargo-type" value="parcel" checked /> Bưu kiện
                            </label>
                            <label class="radio-label-custom">
                                <input type="radio" name="cargo-type" value="document" /> Tài liệu
                            </label>
                        </div>
                    </div>

                    <!-- Inline Goods Add Form -->
                    <div class="goods-form-card">
                        <div class="form-group-custom" style="margin-bottom: 0.5rem;">
                            <div class="form-label-custom">Tên hàng 1*</div>
                            <div class="input-wrapper-custom">
                                <input type="text" id="new-item-name" class="input-field-custom" placeholder="Nhập tên hàng hóa" />
                            </div>
                            <div style="font-size: 0.75rem; color: var(--vp-red); font-weight: 600; margin-top: 0.25rem; display:none;" id="err-goods-name">
                                Tên hàng hóa không được để trống
                            </div>
                        </div>

                        <!-- Qty, weight, price inputs in row -->
                        <div class="goods-inline-row">
                            <div class="input-wrapper-custom" style="padding: 0.1rem 0.5rem;">
                                <input type="number" id="new-item-qty" class="input-field-custom" value="1" min="1" style="text-align: center;" />
                            </div>
                            <div class="input-wrapper-custom" style="padding: 0.1rem 0.5rem;">
                                <input type="number" id="new-item-weight" class="input-field-custom" placeholder="Trọng lượng" min="1" style="text-align: right;" />
                                <span style="font-size: 0.8rem; font-weight: 700; color: var(--vp-text-muted); margin-left: 0.2rem;">g</span>
                            </div>
                            <div class="input-wrapper-custom" style="padding: 0.1rem 0.5rem;">
                                <input type="text" id="new-item-price" class="input-field-custom" placeholder="Giá trị hàng" style="text-align: right;" oninput="formatCurrencyInput(this)" />
                                <span style="font-size: 0.8rem; font-weight: 700; color: var(--vp-text-muted); margin-left: 0.2rem;">đ</span>
                            </div>
                        </div>
                        <div style="display: flex; justify-content: space-between; font-size: 0.75rem; color: var(--vp-red); font-weight: 600; margin-top: 0.25rem;">
                            <div></div>
                            <div id="err-goods-weight" style="display:none;">Trọng lượng không được để trống</div>
                            <div></div>
                        </div>

                        <button type="button" class="btn-add-goods" onclick="addManualItem()">
                            <i class="fas fa-plus"></i> Thêm hàng hóa
                        </button>
                    </div>

                    <!-- Active Added Products List -->
                    <div id="added-products-list" style="margin-top: 1rem; min-height: 20px;">
                        <!-- JS injects rows here dynamically -->
                        <div id="empty-products-placeholder" style="text-align: center; color: var(--vp-text-muted); padding: 1rem 0; font-size: 0.825rem; font-weight: 600;">
