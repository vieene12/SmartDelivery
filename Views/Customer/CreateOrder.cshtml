                            <label class="checkbox-label-custom">
                                <input type="checkbox" /> Dễ vỡ
                            </label>
                            <label class="checkbox-label-custom">
                                <input type="checkbox" /> Nguyên khối
                            </label>
                            <label class="checkbox-label-custom">
                                <input type="checkbox" /> Quá khổ
                            </label>
                            <label class="checkbox-label-custom">
                                <input type="checkbox" /> Chất lỏng
                            </label>
                            <label class="checkbox-label-custom">
                                <input type="checkbox" /> Từ tính, Pin
                            </label>
                        </div>

                        <!-- Dimensions row -->
                        <div class="form-label-custom">Kích thước (DxRxC)</div>
                        <div style="display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 0.5rem; margin-bottom: 1rem;">
                            <div class="input-wrapper-custom" style="padding: 0.1rem 0.5rem;">
                                <input type="number" id="dim-l" placeholder="Dài (cm)" class="input-field-custom" style="text-align: center;" oninput="calculateVolumetricWeight()" />
                            </div>
                            <div class="input-wrapper-custom" style="padding: 0.1rem 0.5rem;">
                                <input type="number" id="dim-w" placeholder="Rộng (cm)" class="input-field-custom" style="text-align: center;" oninput="calculateVolumetricWeight()" />
                            </div>
                            <div class="input-wrapper-custom" style="padding: 0.1rem 0.5rem;">
                                <input type="number" id="dim-h" placeholder="Cao (cm)" class="input-field-custom" style="text-align: center;" oninput="calculateVolumetricWeight()" />
                            </div>
                        </div>

                        <!-- Volumetric Weight -->
                        <div class="form-group-custom">
                            <div class="form-label-custom">Quy đổi</div>
                            <div class="input-wrapper-custom" style="background: #F1F5F9; border-color: #E2E8F0;">
                                <input type="text" id="volumetric-weight" class="input-field-custom" placeholder="Khối lượng quy đổi từ kích thước hàng hóa" readonly style="font-weight: 700; color: var(--vp-text-muted);" />
                                <span style="font-size: 0.8rem; font-weight: 700; color: var(--vp-text-muted); margin-left: 0.2rem;">g</span>
                            </div>
                        </div>

                        <!-- Custom Order ID -->
                        <div class="form-group-custom">
                            <div class="form-label-custom">Mã đơn hàng</div>
                            <div class="input-wrapper-custom">
                                <input type="text" class="input-field-custom" placeholder="Nhập mã đơn hàng tự tạo" />
                            </div>
                        </div>
                    </div>

                    <!-- CARD 6: TIỀN THU HỘ -->
                    <div style="margin-top: 1.5rem; background: #FFF1F2; border: 1.2px solid rgba(227, 6, 19, 0.15); border-radius: 8px; padding: 1rem; display: flex; flex-direction: column; gap: 0.5rem;">
                        <div style="display: flex; justify-content: space-between; align-items: center;">
                            <span style="font-size: 0.825rem; font-weight: 800; color: var(--vp-text-dark);">TIỀN THU HỘ (COD)</span>
                            <label style="display: inline-flex; align-items: center; gap: 0.35rem; font-size: 0.825rem; font-weight: 700; cursor: pointer;">
                                <input type="checkbox" id="cod-sync-checkbox" style="accent-color: var(--vp-red);" onchange="toggleCodSync(this.checked)" /> Thu hộ bằng giá trị hàng
                            </label>
                        </div>
                        <div class="input-wrapper-custom" id="cod-input-container" style="background: white; border-color: rgba(227, 6, 19, 0.15);">
                            <input type="text" id="cod-amount-input" class="input-field-custom" value="0" style="text-align: right;" oninput="onCodAmountInput(this)" />
                            <span style="font-size: 0.85rem; font-weight: 700; color: var(--vp-text-muted); margin-left: 0.25rem;">đ</span>
                        </div>
                    </div>

                    <!-- CARD 7: NGƯỜI TRẢ CƯỚC -->
                    <div style="margin-top: 1.25rem; background: white; border: 1px solid var(--vp-border); border-radius: 8px; padding: 1rem;">
                        <div class="form-label-custom">Người trả cước</div>
                        <div class="radio-group-custom" style="margin-bottom: 0;">
                            <label class="radio-label-custom">
                                <input type="radio" name="payer-radio" value="COD" checked onchange="updatePaymentSide('COD')" /> Người gửi
                            </label>
                            <label class="radio-label-custom">
                                <input type="radio" name="payer-radio" value="ReceiverPay" onchange="updatePaymentSide('ReceiverPay')" /> Người nhận
                            </label>
                        </div>
                    </div>

                    <!-- CARD 8: GHI CHÚ -->
                    <div style="margin-top: 1.25rem;">
                        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.4rem;">
                            <span class="form-label-custom" style="margin-bottom: 0;">Ghi chú</span>
                            <a href="javascript:void(0)" onclick="alert('Đã sẵn sàng các mẫu ghi chú')" style="font-size: 0.8rem; color: var(--vp-red); font-weight: 700; text-decoration: none;">
                                Ghi chú mẫu
                            </a>
                        </div>
                        <div class="input-wrapper-custom" style="padding: 0.5rem 0.75rem;">
                            <textarea id="order-notes" class="input-field-custom" rows="3" placeholder="Nhập ghi chú" style="resize: none; font-family: inherit; font-size: 0.875rem;"></textarea>
                        </div>
                        <label style="display: flex; align-items: center; gap: 0.4rem; font-size: 0.825rem; font-weight: 600; margin-top: 0.75rem; cursor: pointer;">
                            <input type="checkbox" style="accent-color: var(--vp-red);" /> Lưu thông tin đơn hàng
                        </label>
                    </div>
                </div>
            </div>
        </div>

        <!-- STICKY BOTTOM ACTIONS BAR matching screenshot perfectly -->
        <div class="sticky-bottom-bar">
            <div class="sticky-content">
                <!-- Left: summaries -->
                <div class="sticky-summary-block">
                    <div class="sticky-summary-item">
                        <span class="sticky-summary-lbl">Tổng cước</span>
                        <span class="sticky-summary-val" id="sticky-val-total">20.000 đ</span>
                    </div>
                    <div class="sticky-summary-item" style="border-left: 1.5px solid var(--vp-border); padding-left: 1.5rem;">
                        <span class="sticky-summary-lbl">Tiền thu hộ</span>
                        <span class="sticky-summary-val" id="sticky-val-cod" style="color: var(--vp-text-dark);">0 đ</span>
                    </div>
                </div>

                <!-- Middle: delivery estimation -->
                <div style="font-size: 0.85rem; font-weight: 600; color: var(--vp-text-muted);">
                    Thời gian dự kiến: <span style="color: var(--vp-text-dark); font-weight: 700;">1 - 2 ngày (Nội tỉnh)</span>
                </div>

                <!-- Right: actions & agreement -->
                <div class="sticky-actions-block">
                    <label class="checkbox-agreement">
                        <input type="checkbox" id="agreement-checkbox" checked /> Tôi đã đọc và đồng ý với <a href="javascript:void(0)" onclick="alert('Xem điều khoản')" style="color: var(--vp-red); text-decoration: none;">Điều khoản quy định</a>
                    </label>
                    
                    <button type="button" class="btn-reset-custom" onclick="resetFormCustom()">Làm mới</button>
                    <button type="button" class="btn-draft-custom" onclick="alert('Đã lưu nháp bưu gửi thành công!')">Lưu nháp</button>
                    <button type="button" class="btn-create-order" onclick="submitCreateOrderForm()">Gửi ngay</button>
                </div>
            </div>
        </div>
    </form>
</div>

<!-- DANH MỤC HÀNG HÓA MẪU MODAL (Quản lý danh sách hàng hóa) -->
<div class="modal-overlay-custom" id="catalog-modal-overlay" onclick="closeCatalogModalOutside(event)">
    <div class="modal-content-custom">
        <div class="modal-header-custom">
            <div class="modal-title-custom">
                <i class="fas fa-boxes-packing"></i> Danh mục hàng hóa mẫu
            </div>
            <button type="button" class="modal-close-btn" onclick="closeCatalogModal()">
                <i class="fas fa-times"></i>
            </button>
        </div>
        <div class="modal-body-custom">
            <div class="modal-search-wrapper">
                <div class="input-wrapper-custom">
                    <i class="fas fa-search" style="color: var(--vp-text-muted); margin-right: 0.5rem;"></i>
                    <input type="text" id="catalog-search-input" class="input-field-custom" placeholder="Tìm kiếm hàng hóa mẫu theo tên hoặc mô tả..." oninput="filterCatalogGoods()" />
                </div>
            </div>
            <div id="catalog-goods-container">
                <!-- Javascript will inject catalog cards here -->
            </div>
        </div>
    </div>
</div>

<script>
    // Seeded catalog goods from database
    const dbCatalogGoods = [
        @if (ViewBag.HangHoas != null)
        {
            foreach (var item in (List<SDMS.Models.HangHoa>)ViewBag.HangHoas)
            {
                <text>{
                    id: @Html.Raw(Json.Serialize(item.MaHangHoa)),
                    name: @Html.Raw(Json.Serialize(item.TenHangHoa)),
                    weightG: @Html.Raw(Json.Serialize((double)item.KhoiLuong * 1000)),
                    dimensions: @Html.Raw(Json.Serialize(item.KichThuoc ?? "")),
                    description: @Html.Raw(Json.Serialize(item.MoTaChiTiet ?? "")),
                    category: @Html.Raw(Json.Serialize(item.MaNhomHang ?? ""))
                },</text>
            }
        }
    ];

    // Catalog modal control functions
    function openCatalogModal() {
        document.getElementById("catalog-modal-overlay").style.display = "flex";
        document.getElementById("catalog-search-input").value = "";
        renderCatalogGoods(dbCatalogGoods);
    }

    function closeCatalogModal() {
        document.getElementById("catalog-modal-overlay").style.display = "none";
    }

    function closeCatalogModalOutside(event) {
        if (event.target === document.getElementById("catalog-modal-overlay")) {
            closeCatalogModal();
        }
    }

    function renderCatalogGoods(goodsList) {
        const container = document.getElementById("catalog-goods-container");
        container.innerHTML = "";

        if (goodsList.length === 0) {
            container.innerHTML = `
                <div style="text-align: center; color: var(--vp-text-muted); padding: 2rem 0; font-size: 0.875rem; font-weight: 600;">
                    Không tìm thấy hàng hóa mẫu nào phù hợp.
                </div>
            `;
            return;
        }

        const grid = document.createElement("div");
        grid.className = "catalog-goods-grid";

        goodsList.forEach(item => {
            const card = document.createElement("div");
            card.className = "catalog-item-card";
            card.innerHTML = `
                <div class="catalog-item-info">
                    <h4>${item.name}</h4>
                    <p>Khối lượng: ${item.weightG.toLocaleString('vi-VN')} g &nbsp;|&nbsp; Kích thước: ${item.dimensions || "Chưa rõ"}</p>
                    <span class="catalog-tag">${item.category}</span>
                    ${item.description ? `<p style="margin-top:0.35rem; font-style:italic; font-size:0.775rem;">${item.description}</p>` : ''}
                </div>
                <div class="catalog-item-actions">
                    <button type="button" class="btn-catalog-select" onclick="selectCatalogItem('${item.id}')" title="Chọn để chỉnh sửa thông tin hàng">Chọn</button>
                    <button type="button" class="btn-catalog-add" onclick="quickAddCatalogItem('${item.id}')" title="Thêm trực tiếp vào đơn hàng">Thêm nhanh</button>
                </div>
            `;
            grid.appendChild(card);
        });

        container.appendChild(grid);
    }

    function filterCatalogGoods() {
        const query = document.getElementById("catalog-search-input").value.trim().toLowerCase();
        if (!query) {
            renderCatalogGoods(dbCatalogGoods);
            return;
        }

        const filtered = dbCatalogGoods.filter(item => 
            item.name.toLowerCase().includes(query) || 
            item.description.toLowerCase().includes(query) ||
            item.category.toLowerCase().includes(query)
        );
        renderCatalogGoods(filtered);
    }

    function selectCatalogItem(itemId) {
        const item = dbCatalogGoods.find(i => i.id === itemId);
        if (!item) return;

        // Auto-fill manual inputs
        document.getElementById("new-item-name").value = item.name;
        document.getElementById("new-item-weight").value = item.weightG;
        document.getElementById("new-item-qty").value = "1";
        document.getElementById("new-item-price").value = ""; // Let them type price

        // Pre-fill dimensions if available
        if (item.dimensions) {
            const parts = item.dimensions.toLowerCase().replace(/[^0-9x]/g, "").split("x");
            if (parts.length === 3) {
                document.getElementById("dim-l").value = parts[0];
                document.getElementById("dim-w").value = parts[1];
                document.getElementById("dim-h").value = parts[2];
                calculateVolumetricWeight();
            }
        }

        closeCatalogModal();
        document.getElementById("new-item-name").focus();
        
        // Highlight inputs briefly
        const fields = ["new-item-name", "new-item-weight", "new-item-qty"];
        fields.forEach(id => {
            const input = document.getElementById(id);
            if (input) {
                input.style.backgroundColor = "#FFF1F2";
                setTimeout(() => {
                    input.style.backgroundColor = "";
                }, 800);
            }
        });
    }

    function quickAddCatalogItem(itemId) {
        const item = dbCatalogGoods.find(i => i.id === itemId);
        if (!item) return;

        // Check if item is already added to manualItems
        const existing = manualItems.find(i => i.name === item.name);
        if (existing) {
            existing.qty++;
        } else {
            manualItemCounter++;
            manualItems.push({
                id: manualItemCounter,
                name: item.name,
                weightG: item.weightG,
                qty: 1,
                price: 0
            });
        }

        renderAddedProducts();
        calculateAllTotals();
        closeCatalogModal();
        alert(`Đã thêm nhanh mặt hàng "${item.name}" vào danh sách!`);
    }

    // Array of manually added items: [{ id, name, weightG, qty, price }]
    let manualItems = [];
    let manualItemCounter = 0;

    // Standard Address Data mapping
    const addressData = {
        "Hà Nội": {
            "Cầu Giấy": ["Dịch Vọng", "Dịch Vọng Hậu", "Yên Hòa", "Mai Dịch", "Quan Hoa"],
            "Ba Đình": ["Trúc Bạch", "Vĩnh Phúc", "Cống Vị", "Kim Mã", "Giảng Võ"],
            "Đống Đa": ["Láng Thượng", "Láng Hạ", "Cát Linh", "Quốc Tử Giám", "Khương Thượng"]
        },
        "TP. Hồ Chí Minh": {
            "Quận 1": ["Bến Nghé", "Bến Thành", "Đa Kao", "Tân Định", "Phạm Ngũ Lão"],
            "Quận 3": ["Võ Thị Sáu", "Phường 1", "Phường 2", "Phường 5", "Phường 9"],
            "Quận 10": ["Phường 1", "Phường 2", "Phường 12", "Phường 14", "Phường 15"]
        },
        "Đà Nẵng": {
            "Hải Châu": ["Thạch Thang", "Thanh Bình", "Thuận Phước", "Hòa Cường Bắc", "Hòa Cường Nam"],
            "Thanh Khê": ["Vĩnh Trung", "Tân Chính", "Thạc Gián", "Chính Gián", "Hòa Khê"]
        },
        "Bình Dương": {
            "Thủ Dầu Một": ["Phú Cường", "Hiệp Thành", "Chánh Nghĩa", "Phú Hòa", "Phú Lợi"],
            "Thuận An": ["Lái Thiêu", "An Thạnh", "Vĩnh Phú", "Bình Hòa", "Thuận Giao"]
        }
    };

    let currentAddressType = 'detail';

    // Dropdown change handlers
    function onProvinceChange() {
        const province = document.getElementById("addr-province").value;
        const districtSelect = document.getElementById("addr-district");
        const wardSelect = document.getElementById("addr-ward");

        districtSelect.innerHTML = '<option value="" disabled selected>Huyện/Quận *</option>';
        wardSelect.innerHTML = '<option value="" disabled selected>Xã/Phường *</option>';
        wardSelect.disabled = true;

        if (addressData[province]) {
            districtSelect.disabled = false;
            for (const district in addressData[province]) {
                const opt = document.createElement("option");
                opt.value = district;
                opt.innerText = district;
                districtSelect.appendChild(opt);
            }
        } else {
            districtSelect.disabled = true;
        }
        updateCombinedAddress();
    }

    function onDistrictChange() {
        const province = document.getElementById("addr-province").value;
        const district = document.getElementById("addr-district").value;
        const wardSelect = document.getElementById("addr-ward");

        wardSelect.innerHTML = '<option value="" disabled selected>Xã/Phường *</option>';

        if (addressData[province] && addressData[province][district]) {
            wardSelect.disabled = false;
            addressData[province][district].forEach(ward => {
                const opt = document.createElement("option");
                opt.value = ward;
                opt.innerText = ward;
                wardSelect.appendChild(opt);
            });
        } else {
            wardSelect.disabled = true;
        }
        updateCombinedAddress();
    }

    function updateCombinedAddress() {
        const house = document.getElementById("addr-house").value.trim();
        const street = document.getElementById("addr-street").value;
        const ward = document.getElementById("addr-ward").value;
        const district = document.getElementById("addr-district").value;
        const province = document.getElementById("addr-province").value;

        let parts = [];
        if (house) parts.push(house);
        if (street && street !== "") parts.push(street);
        if (ward && ward !== "Xã/Phường *") parts.push(ward);
        if (district && district !== "Huyện/Quận *") parts.push(district);
        if (province && province !== "Tỉnh/Thành phố *") parts.push(province);

        if (currentAddressType === 'smart-box') {
            parts.unshift("[Tủ Smart Box]");
        } else if (currentAddressType === 'post-office') {
            parts.unshift("[Bưu Cục]");
        }

        const combined = parts.join(", ");
        document.getElementById("full-address-hidden").value = combined;
    }

    function selectAddressType(type) {
        currentAddressType = type;
        updateCombinedAddress();
    }

    // Format currency display helper
    function formatCurrencyInput(input) {
        let val = input.value.replace(/[^0-9]/g, "");
        if (val) {
            input.value = parseInt(val).toLocaleString('vi-VN');
        } else {
            input.value = "";
        }
    }

    // Add manually entered item to the list
    function addManualItem() {
        const nameInput = document.getElementById("new-item-name");
        const weightInput = document.getElementById("new-item-weight");
        const qtyInput = document.getElementById("new-item-qty");
        const priceInput = document.getElementById("new-item-price");

        const errName = document.getElementById("err-goods-name");
        const errWeight = document.getElementById("err-goods-weight");

        const name = nameInput.value.trim();
        const weightG = parseFloat(weightInput.value) || 0;
        const qty = parseInt(qtyInput.value) || 1;
        
        const priceText = priceInput.value.replace(/[^0-9]/g, "") || "0";
        const price = parseInt(priceText);

        let hasError = false;
        if (!name) {
            nameInput.style.borderColor = 'var(--vp-red)';
            errName.style.display = 'block';
            hasError = true;
        } else {
            nameInput.style.borderColor = '';
            errName.style.display = 'none';
        }

        if (weightG <= 0) {
            weightInput.style.borderColor = 'var(--vp-red)';
            errWeight.style.display = 'block';
            hasError = true;
        } else {
            weightInput.style.borderColor = '';
            errWeight.style.display = 'none';
        }

        if (hasError) return;

        manualItemCounter++;
        manualItems.push({ id: manualItemCounter, name, weightG, qty, price });

        // Reset inputs
        nameInput.value = '';
        weightInput.value = '';
        qtyInput.value = '1';
        priceInput.value = '';
        nameInput.focus();

        renderAddedProducts();
        calculateAllTotals();
    }

    // Render HTML list for manually added items
    function renderAddedProducts() {
        const list = document.getElementById("added-products-list");
        const placeholder = document.getElementById("empty-products-placeholder");

        // Clear existing product rows
        list.querySelectorAll('.added-product-row').forEach(r => r.remove());

        if (manualItems.length === 0) {
            placeholder.style.display = "block";
            return;
        }

        placeholder.style.display = "none";

        manualItems.forEach(item => {
            const row = document.createElement("div");
            row.className = "added-product-row";
            row.innerHTML = `
                <div class="prod-details">
                    <h4>${item.name}</h4>
                    <p>KL: ${item.weightG.toLocaleString('vi-VN')} g &nbsp;|&nbsp; Trị giá: ${item.price.toLocaleString('vi-VN')} đ</p>
                </div>
                <div style="display:flex; align-items:center; gap:0.5rem;">
                    <div class="qty-counter">
                        <button type="button" class="counter-btn" onclick="adjustManualItemQty(${item.id}, -1)">-</button>
                        <span class="counter-val">${item.qty}</span>
                        <button type="button" class="counter-btn" onclick="adjustManualItemQty(${item.id}, 1)">+</button>
                    </div>
                    <button type="button" onclick="removeManualItem(${item.id})" style="background:transparent; border:none; color:#94A3B8; cursor:pointer; font-size:1.1rem; padding:0.25rem;" title="Xóa">
                        <i class="fas fa-times-circle"></i>
                    </button>
                </div>
            `;
            list.appendChild(row);
        });

        syncInputsForSubmit();
    }

    // Adjust quantity of a manual item
    function adjustManualItemQty(id, delta) {
        const item = manualItems.find(i => i.id === id);
        if (!item) return;
        item.qty = Math.max(1, item.qty + delta);
        renderAddedProducts();
        calculateAllTotals();
    }

    // Remove a manual item
    // Sync manual items to hidden inputs for form POST
    function removeManualItem(id) {
        manualItems = manualItems.filter(i => i.id !== id);
        renderAddedProducts();
        calculateAllTotals();
    }

    function syncInputsForSubmit() {
        const container = document.getElementById("post-products-data-container");
        container.innerHTML = "";

        manualItems.forEach((item, idx) => {
            const nameInput = document.createElement("input");
            nameInput.type = "hidden";
            nameInput.name = `manualItems[${idx}].TenHangHoa`;
            nameInput.value = item.name;
            container.appendChild(nameInput);

            const weightInput = document.createElement("input");
            weightInput.type = "hidden";
            weightInput.name = `manualItems[${idx}].KhoiLuong`;
            weightInput.value = (item.weightG / 1000).toFixed(3);
            container.appendChild(weightInput);

            const qtyInput = document.createElement("input");
            qtyInput.type = "hidden";
            qtyInput.name = `manualItems[${idx}].SoLuong`;
            qtyInput.value = item.qty;
            container.appendChild(qtyInput);
        });
    }

    // Volumetric Weight Calculation from Dimensions (D x R x C)
    function calculateVolumetricWeight() {
        const dimL = parseFloat(document.getElementById("dim-l").value) || 0;
        const dimW = parseFloat(document.getElementById("dim-w").value) || 0;
        const dimH = parseFloat(document.getElementById("dim-h").value) || 0;

        // Logistics volumetric divisor: standard is L * W * H / 5000 in grams
        if (dimL > 0 && dimW > 0 && dimH > 0) {
            const volWeightG = Math.round((dimL * dimW * dimH) / 5 * 1000) / 1000; 
            document.getElementById("volumetric-weight").value = volWeightG.toLocaleString('vi-VN');
        } else {
            document.getElementById("volumetric-weight").value = "";
        }
        calculateAllTotals();
    }

    // Manual inputs overrides
    function onManualWeightInput(input) {
        calculateAllTotals();
    }

    function onManualPriceInput(input) {
        formatCurrencyInput(input);
        if (document.getElementById("cod-sync-checkbox").checked) {
            document.getElementById("cod-amount-input").value = input.value;
            document.getElementById("sticky-val-cod").innerText = input.value + " đ";
        }
        calculateAllTotals();
    }

    function onCodAmountInput(input) {
        formatCurrencyInput(input);
        document.getElementById("sticky-val-cod").innerText = input.value ? input.value + " đ" : "0 đ";
    }

    function toggleCodSync(isChecked) {
        const codInput = document.getElementById("cod-amount-input");
        if (isChecked) {
            let totalValue = 0;
            manualItems.forEach(item => {
                totalValue += item.price * item.qty;
            });
            const formatted = totalValue > 0 ? totalValue.toLocaleString('vi-VN') : "0";
            codInput.value = formatted;
            document.getElementById("sticky-val-cod").innerText = formatted + " đ";
        }
    }

    // Centralised calculator for all weights, costs and sums
    function calculateAllTotals() {
        let totalWeightKg = 0;
        let totalValue = 0;

        if (manualItems.length > 0) {
            manualItems.forEach(item => {
                totalWeightKg += (item.weightG / 1000) * item.qty;
                totalValue += item.price * item.qty;
            });
        }

        // Add volumetric weight if exists
        const volWeightText = document.getElementById("volumetric-weight").value.replace(/[^0-9]/g, "") || "0";
        const volWeightG = parseFloat(volWeightText) || 0;
        totalWeightKg += volWeightG / 1000;

        // Set hidden forms fields for ASP.NET MVC binding
        document.getElementById("total-weight-hidden").value = totalWeightKg.toFixed(3);

        // Core business fee formula from CustomerController: Base 20k + 5k/kg
        const shippingFee = 20000 + (totalWeightKg * 5000);

        const formatter = new Intl.NumberFormat('vi-VN');

        // Update UI displays
        document.getElementById("label-summary-weight").innerText = (totalWeightKg * 1000).toLocaleString('vi-VN') + " g";
        document.getElementById("label-summary-price").innerText = totalValue.toLocaleString('vi-VN') + " đ";
        
        document.getElementById("pricing-express-fee").innerText = formatter.format(shippingFee) + " đ";
        document.getElementById("sticky-val-total").innerText = formatter.format(shippingFee) + " đ";

        // Update COD if sync is checked
        if (document.getElementById("cod-sync-checkbox").checked) {
            const formatted = totalValue > 0 ? totalValue.toLocaleString('vi-VN') : "0";
            document.getElementById("cod-amount-input").value = formatted;
            document.getElementById("sticky-val-cod").innerText = formatted + " đ";
        }
    }

    function updatePaymentSide(method) {
        document.getElementById("payment-method-hidden").value = method;
    }

    // Reset Form completely
    function resetFormCustom() {
        document.getElementById("create-order-form").reset();
        manualItems = [];
        renderAddedProducts();
        calculateAllTotals();
        alert("Đã làm mới form thông tin đơn hàng!");
    }

    // Submit validator & execution
    function submitCreateOrderForm() {
        const form = document.getElementById("create-order-form");

        // Validate agreement checkbox
        const agreement = document.getElementById("agreement-checkbox");
        if (!agreement.checked) {
            alert("Bạn cần phải đồng ý với Điều khoản quy định trước khi gửi!");
            return;
        }

        // Validate basic inputs
        const tel = document.getElementById("SoDienThoaiNguoiNhan").value.trim();
        const name = document.getElementById("TenNguoiNhan").value.trim();
        const house = document.getElementById("addr-house").value.trim();
        const province = document.getElementById("addr-province").value;
        const district = document.getElementById("addr-district").value;
        const ward = document.getElementById("addr-ward").value;

        if (!tel || !name || !house || !province || !district || !ward) {
            alert("Vui lòng điền đầy đủ các thông tin người nhận bắt buộc (*)!");
            return;
        }

        const totalWeight = parseFloat(document.getElementById("total-weight-hidden").value) || 0;
        if (totalWeight <= 0) {
            alert("Vui lòng nhập hoặc thêm ít nhất một mặt hàng để tính khối lượng!");
            return;
        }

        form.submit();
    }

    // Initialize triggers
    document.addEventListener("DOMContentLoaded", () => {
        calculateAllTotals();
    });
</script>
