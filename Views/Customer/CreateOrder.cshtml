    let currentAddressType = 'detail';

    // Dropdown change handlers
    function onProvinceChange() {
        const province = document.getElementById("addr-province").value;
        const districtSelect = document.getElementById("addr-district");
        const wardSelect = document.getElementById("addr-ward");

        // Reset manual custom input wrappers and values
        document.getElementById("custom-district-wrapper").style.display = "none";
        document.getElementById("addr-district-custom").value = "";
        document.getElementById("custom-ward-wrapper").style.display = "none";
        document.getElementById("addr-ward-custom").value = "";

        districtSelect.innerHTML = '<option value="" disabled selected>Huyện/Quận *</option>';
        wardSelect.innerHTML = '<option value="" disabled selected>Xã/Phường *</option>';
        wardSelect.disabled = true;

        if (addressData[province]) {
            districtSelect.disabled = false;
            for (const district in addressData[province]) {
                const opt = document.createElement("option");
                opt.value = district;
                opt.innerText = district;
                districtSelect.appendChild(opt);
            }
        } else {
            districtSelect.disabled = true;
        }
        updateCombinedAddress();
    }

    function onDistrictChange() {
        const province = document.getElementById("addr-province").value;
        const district = document.getElementById("addr-district").value;
        const wardSelect = document.getElementById("addr-ward");

        // Reset ward custom input wrapper and value
        document.getElementById("custom-ward-wrapper").style.display = "none";
        document.getElementById("addr-ward-custom").value = "";

        if (district === "Khác (Tự nhập)") {
            document.getElementById("custom-district-wrapper").style.display = "block";
            document.getElementById("addr-district-custom").focus();
            
            wardSelect.innerHTML = '<option value="Khác (Tự nhập)" selected>Khác (Tự nhập)</option>';
            wardSelect.disabled = false;
            onWardChange();
        } else {
            document.getElementById("custom-district-wrapper").style.display = "none";
            document.getElementById("addr-district-custom").value = "";
            
            wardSelect.innerHTML = '<option value="" disabled selected>Xã/Phường *</option>';

            if (addressData[province] && addressData[province][district]) {
                wardSelect.disabled = false;
                addressData[province][district].forEach(ward => {
                    const opt = document.createElement("option");
                    opt.value = ward;
                    opt.innerText = ward;
                    wardSelect.appendChild(opt);
                });
            } else {
                wardSelect.disabled = true;
            }
        }
        updateCombinedAddress();
    }

    function onWardChange() {
        const ward = document.getElementById("addr-ward").value;
        if (ward === "Khác (Tự nhập)") {
            document.getElementById("custom-ward-wrapper").style.display = "block";
            document.getElementById("addr-ward-custom").focus();
        } else {
            document.getElementById("custom-ward-wrapper").style.display = "none";
            document.getElementById("addr-ward-custom").value = "";
        }
        updateCombinedAddress();
    }

    function updateCombinedAddress() {
        const house = document.getElementById("addr-house").value.trim();
        const street = document.getElementById("addr-street").value;

        let province = document.getElementById("addr-province").value;
        if (province === "Tỉnh/Thành phố *") province = "";

        let district = document.getElementById("addr-district").value;
        if (district === "Huyện/Quận *" || district === "") {
            district = "";
        } else if (district === "Khác (Tự nhập)") {
            district = document.getElementById("addr-district-custom").value.trim();
        }

        let ward = document.getElementById("addr-ward").value;
        if (ward === "Xã/Phường *" || ward === "") {
            ward = "";
        } else if (ward === "Khác (Tự nhập)") {
            ward = document.getElementById("addr-ward-custom").value.trim();
        }

        let parts = [];
        if (house) parts.push(house);
        if (street && street !== "") parts.push(street);
        if (ward) parts.push(ward);
        if (district) parts.push(district);
        if (province) parts.push(province);

        if (currentAddressType === 'smart-box') {
            parts.unshift("[Tủ Smart Box]");
        } else if (currentAddressType === 'post-office') {
            parts.unshift("[Bưu Cục]");
        }

        const combined = parts.join(", ");
        document.getElementById("full-address-hidden").value = combined;
    }

    function selectAddressType(type) {
        currentAddressType = type;
        updateCombinedAddress();
    }

    // Format currency display helper
    function formatCurrencyInput(input) {
        let val = input.value.replace(/[^0-9]/g, "");
        if (val) {
            input.value = parseInt(val).toLocaleString('vi-VN');
        } else {
            input.value = "";
        }
    }

    // Add manually entered item to the list
    function addManualItem() {
        const nameInput = document.getElementById("new-item-name");
        const weightInput = document.getElementById("new-item-weight");
        const qtyInput = document.getElementById("new-item-qty");
        const priceInput = document.getElementById("new-item-price");

        const errName = document.getElementById("err-goods-name");
        const errWeight = document.getElementById("err-goods-weight");

        const name = nameInput.value.trim();
        const weightG = parseFloat(weightInput.value) || 0;
        const qty = parseInt(qtyInput.value) || 1;
        
        const priceText = priceInput.value.replace(/[^0-9]/g, "") || "0";
        const price = parseInt(priceText);

        let hasError = false;
        if (!name) {
            nameInput.style.borderColor = 'var(--vp-red)';
            errName.style.display = 'block';
            hasError = true;
        } else {
            nameInput.style.borderColor = '';
            errName.style.display = 'none';
        }

        if (weightG <= 0) {
            weightInput.style.borderColor = 'var(--vp-red)';
            errWeight.style.display = 'block';
            hasError = true;
        } else {
            weightInput.style.borderColor = '';
            errWeight.style.display = 'none';
        }

        if (hasError) return;

        manualItemCounter++;
        manualItems.push({ id: manualItemCounter, name, weightG, qty, price });

        // Reset inputs
        nameInput.value = '';
        weightInput.value = '';
        qtyInput.value = '1';
        priceInput.value = '';
        nameInput.focus();

        renderAddedProducts();
        calculateAllTotals();
    }

    // Render HTML list for manually added items
    function renderAddedProducts() {
        const list = document.getElementById("added-products-list");
        const placeholder = document.getElementById("empty-products-placeholder");

        // Clear existing product rows
        list.querySelectorAll('.added-product-row').forEach(r => r.remove());

        if (manualItems.length === 0) {
            placeholder.style.display = "block";
            return;
        }

        placeholder.style.display = "none";

        manualItems.forEach(item => {
            const row = document.createElement("div");
            row.className = "added-product-row";
            row.innerHTML = `
                <div class="prod-details">
                    <h4>${item.name}</h4>
                    <p>KL: ${item.weightG.toLocaleString('vi-VN')} g &nbsp;|&nbsp; Trị giá: ${item.price.toLocaleString('vi-VN')} đ</p>
                </div>
                <div style="display:flex; align-items:center; gap:0.5rem;">
                    <div class="qty-counter">
                        <button type="button" class="counter-btn" onclick="adjustManualItemQty(${item.id}, -1)">-</button>
                        <span class="counter-val">${item.qty}</span>
                        <button type="button" class="counter-btn" onclick="adjustManualItemQty(${item.id}, 1)">+</button>
                    </div>
                    <button type="button" onclick="removeManualItem(${item.id})" style="background:transparent; border:none; color:#94A3B8; cursor:pointer; font-size:1.1rem; padding:0.25rem;" title="Xóa">
                        <i class="fas fa-times-circle"></i>
                    </button>
                </div>
            `;
            list.appendChild(row);
        });

        syncInputsForSubmit();
    }

    // Adjust quantity of a manual item
    function adjustManualItemQty(id, delta) {
        const item = manualItems.find(i => i.id === id);
        if (!item) return;
        item.qty = Math.max(1, item.qty + delta);
        renderAddedProducts();
        calculateAllTotals();
    }

    // Remove a manual item
    // Sync manual items to hidden inputs for form POST
    function removeManualItem(id) {
        manualItems = manualItems.filter(i => i.id !== id);
        renderAddedProducts();
        calculateAllTotals();
    }

    function syncInputsForSubmit() {
        const container = document.getElementById("post-products-data-container");
        container.innerHTML = "";

        manualItems.forEach((item, idx) => {
            const nameInput = document.createElement("input");
            nameInput.type = "hidden";
            nameInput.name = `manualItems[${idx}].TenHangHoa`;
            nameInput.value = item.name;
            container.appendChild(nameInput);

            const weightInput = document.createElement("input");
            weightInput.type = "hidden";
            weightInput.name = `manualItems[${idx}].KhoiLuong`;
            weightInput.value = (item.weightG / 1000).toFixed(3);
            container.appendChild(weightInput);

            const qtyInput = document.createElement("input");
            qtyInput.type = "hidden";
            qtyInput.name = `manualItems[${idx}].SoLuong`;
            qtyInput.value = item.qty;
            container.appendChild(qtyInput);
        });
    }

    // Volumetric Weight Calculation from Dimensions (D x R x C) - Removed
    function calculateVolumetricWeight() {
        // No longer used
    }

    // Manual inputs overrides
    function onManualWeightInput(input) {
        calculateAllTotals();
    }

    function onManualPriceInput(input) {
        formatCurrencyInput(input);
        calculateAllTotals();
    }

    function onCodAmountInput(input) {
        formatCurrencyInput(input);
        document.getElementById("sticky-val-cod").innerText = input.value ? input.value + " đ" : "0 đ";
    }

    function toggleCodSync(isChecked) {
        calculateAllTotals();
    }

    // Helper to calculate provisional weight and value (both added and active form inputs)
    function getProvisionalTotals() {
        let totalWeightKg = 0;
        let totalValue = 0;

        // Sum added manual items
        manualItems.forEach(item => {
            totalWeightKg += (item.weightG / 1000) * item.qty;
            totalValue += item.price * item.qty;
        });

        // Get current active inputs from inline form
        const currentWeightText = document.getElementById("new-item-weight").value || "0";
        const currentWeightG = parseFloat(currentWeightText) || 0;
        const currentPriceText = document.getElementById("new-item-price").value.replace(/[^0-9]/g, "") || "0";
        const currentPrice = parseInt(currentPriceText) || 0;
        const currentQty = parseInt(document.getElementById("new-item-qty").value) || 1;

        if (manualItems.length === 0) {
            // If the list is empty, treat the current form input values as provisional totals
            if (currentWeightG > 0 || currentPrice > 0) {
                totalWeightKg = (currentWeightG / 1000) * currentQty;
                totalValue = currentPrice * currentQty;
            }
        } else {
            // If the list has items, add the current in-progress input only if it's partially completed
            if (currentWeightG > 0 || currentPrice > 0) {
                totalWeightKg += (currentWeightG / 1000) * currentQty;
                totalValue += currentPrice * currentQty;
            }
        }

        return { totalWeightKg, totalValue };
    }

    // Centralised calculator for all weights, costs and sums
    function calculateAllTotals() {
        const provisional = getProvisionalTotals();
        let totalWeightKg = provisional.totalWeightKg;
        let totalValue = provisional.totalValue;

        // Volumetric weight calculation removed

        // Set hidden forms fields for ASP.NET MVC binding
        document.getElementById("total-weight-hidden").value = totalWeightKg.toFixed(3);

        // Core business fee formula from CustomerController: Base 20k + 5k/kg
        const shippingFee = 20000 + (totalWeightKg * 5000);

        const formatter = new Intl.NumberFormat('vi-VN');

        // Update UI displays
        document.getElementById("label-summary-weight").innerText = (totalWeightKg * 1000).toLocaleString('vi-VN') + " g";
        document.getElementById("label-summary-price").innerText = totalValue.toLocaleString('vi-VN') + " đ";
        
        document.getElementById("pricing-express-fee").innerText = formatter.format(shippingFee) + " đ";
        document.getElementById("sticky-val-total").innerText = formatter.format(shippingFee) + " đ";

        // Update COD if sync is checked
        if (document.getElementById("cod-sync-checkbox").checked) {
            const formatted = totalValue > 0 ? totalValue.toLocaleString('vi-VN') : "0";
            document.getElementById("cod-amount-input").value = formatted;
            document.getElementById("sticky-val-cod").innerText = formatted + " đ";
        }
    }

    function updatePaymentSide(method) {
        document.getElementById("payment-method-hidden").value = method;
    }

    // Reset Form completely
    function resetFormCustom() {
        document.getElementById("create-order-form").reset();
        manualItems = [];
        renderAddedProducts();
        calculateAllTotals();
        alert("Đã làm mới form thông tin đơn hàng!");
    }

    // Submit validator & execution
    function submitCreateOrderForm() {
        const form = document.getElementById("create-order-form");

        // Validate agreement checkbox
        const agreement = document.getElementById("agreement-checkbox");
        if (!agreement.checked) {
            alert("Bạn cần phải đồng ý với Điều khoản quy định trước khi gửi!");
            return;
        }

        // Validate basic inputs
        const tel = document.getElementById("SoDienThoaiNguoiNhan").value.trim();
        const name = document.getElementById("TenNguoiNhan").value.trim();
        const house = document.getElementById("addr-house").value.trim();
        const province = document.getElementById("addr-province").value;
        const district = document.getElementById("addr-district").value;
        const ward = document.getElementById("addr-ward").value;

        if (!tel || !name || !house || !province || !district || !ward) {
            alert("Vui lòng điền đầy đủ các thông tin người nhận bắt buộc (*)!");
            return;
        }

        const totalWeight = parseFloat(document.getElementById("total-weight-hidden").value) || 0;
        if (totalWeight <= 0) {
            alert("Vui lòng nhập hoặc thêm ít nhất một mặt hàng để tính khối lượng!");
            return;
        }

        form.submit();
    }

    // Initialize triggers
    document.addEventListener("DOMContentLoaded", () => {
        calculateAllTotals();
    });
</script>
