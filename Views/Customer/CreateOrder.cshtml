@model SDMS.Models.DonHang
@{
    ViewData["Title"] = "Tạo đơn hàng mới";
}

<style>
    /* Ocean Tech Theme Variables */
    :root {
        --vp-red: #2563eb;
        --vp-red-hover: #1d4ed8;
        --vp-bg-light: var(--bg-secondary, #f8fafc);
        --vp-text-dark: var(--text-main, #0f172a);
        --vp-text-muted: var(--text-muted, #64748b);
        --vp-border: var(--border-color, rgba(226, 232, 240, 0.8));
        --vp-shadow-card: var(--shadow-md);
        --vp-shadow-input: var(--shadow-sm);
    }

    .order-container {
        max-width: 1450px;
        margin: 0 auto;
        padding: 1rem 1.5rem;
        padding-bottom: 150px; /* Space for sticky bar */
        font-family: 'Inter', system-ui, -apple-system, sans-serif;
        color: var(--vp-text-dark);
        background-color: var(--bg-color, #F1F5F9);
    }

    /* Back Header */
    .order-header-bar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 1rem;
        background: var(--card-bg, white);
        padding: 0.75rem 1.5rem;
        border-radius: 8px;
        box-shadow: var(--vp-shadow-card);
        border: 1px solid var(--vp-border);
    }

    .back-btn {
        background: transparent;
        border: none;
        color: var(--vp-text-dark);
        font-size: 1.1rem;
        cursor: pointer;
        display: flex;
        align-items: center;
        gap: 0.5rem;
        text-decoration: none;
        font-weight: 700;
        transition: transform 0.2s;
    }

    .back-btn:hover {
        transform: translateX(-4px);
        color: var(--vp-red);
    }

    /* Form Layout Grid */
    .form-grid {
        display: grid;
        grid-template-columns: 1.2fr 1fr;
        gap: 1.25rem;
    }

    @@media (max-width: 1024px) {
        .form-grid {
            grid-template-columns: 1fr;
        }
    }

    /* Card Panels */
    .premium-card {
        background: var(--card-bg, white);
        border-radius: 8px;
        padding: 1.5rem;
        box-shadow: var(--vp-shadow-card);
        border: 1px solid var(--vp-border);
        margin-bottom: 1.25rem;
    }

    .card-title {
        font-size: 0.95rem;
        font-weight: 800;
        margin-top: 0;
        margin-bottom: 1.25rem;
        display: flex;
        align-items: center;
        justify-content: space-between;
        color: var(--vp-text-dark);
        border-bottom: 1.5px solid var(--border-color, #F1F5F9);
        padding-bottom: 0.75rem;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }

    .card-title-left {
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }

    .card-title-left i {
        font-size: 1.1rem;
        color: var(--vp-red);
    }

    /* Custom Radio styling */
    .radio-group-custom {
        display: flex;
        gap: 1rem;
        margin-bottom: 1rem;
        align-items: center;
    }

    .radio-label-custom {
        display: flex;
        align-items: center;
        gap: 0.35rem;
        font-size: 0.85rem;
        font-weight: 600;
        color: var(--vp-text-dark);
        cursor: pointer;
        user-select: none;
    }

    .radio-label-custom input[type="radio"] {
        accent-color: var(--vp-red);
        width: 16px;
        height: 16px;
    }

    /* Standard Label and Inputs */
    .form-group-custom {
        margin-bottom: 1rem;
    }

    .form-label-custom {
        display: block;
        font-size: 0.825rem;
        font-weight: 700;
        color: var(--vp-text-dark);
        margin-bottom: 0.4rem;
    }

    .input-wrapper-custom {
        display: flex;
        align-items: center;
        background: var(--card-bg, white);
        border: 1.5px solid var(--border-color, #CBD5E1);
        border-radius: 6px;
        padding: 0.15rem 0.75rem;
        transition: all 0.2s;
        box-shadow: var(--vp-shadow-input);
    }

    .input-wrapper-custom:focus-within {
        border-color: var(--vp-red);
        box-shadow: 0 0 0 3px rgba(227, 6, 19, 0.05);
    }

    .input-field-custom {
        flex: 1;
        border: none;
        background: transparent;
        padding: 0.6rem 0;
        font-size: 0.9rem;
        font-weight: 550;
        color: var(--vp-text-dark);
        outline: none;
        width: 100%;
    }

    .input-field-custom::placeholder {
        color: var(--text-light, #94A3B8);
        font-weight: 500;
    }

    /* Select wrappers */
    .select-custom-wrapper {
        background: var(--card-bg, white);
        border: 1.5px solid var(--border-color, #CBD5E1);
        border-radius: 6px;
        padding: 0.15rem 0.75rem;
        box-shadow: var(--vp-shadow-input);
        position: relative;
    }

    .select-custom-wrapper select {
        width: 100%;
        border: none;
        background: transparent;
        font-size: 0.875rem;
        font-weight: 550;
        color: var(--vp-text-dark);
        outline: none;
        cursor: pointer;
        padding: 0.6rem 0;
        -webkit-appearance: none;
        -moz-appearance: none;
        appearance: none;
    }

    .select-custom-wrapper select option {
        background: var(--card-bg, white);
        color: var(--vp-text-dark);
    }

    .select-custom-wrapper::after {
        content: '\f078';
        font-family: 'Font Awesome 6 Free';
        font-weight: 900;
        position: absolute;
        right: 0.9rem;
        top: 50%;
        transform: translateY(-50%);
        color: var(--vp-text-muted);
        font-size: 0.75rem;
        pointer-events: none;
    }

    /* Address Select dropdowns row */
    .dropdown-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 0.75rem;
        margin-bottom: 0.75rem;
    }

    /* Multi-column grid for checkbox selections */
    .checkbox-grid-3col {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 0.75rem;
        margin-bottom: 1.25rem;
    }

    .checkbox-label-custom {
        display: flex;
        align-items: center;
        gap: 0.4rem;
        font-size: 0.825rem;
        font-weight: 600;
        color: var(--vp-text-dark);
        cursor: pointer;
    }

    .checkbox-label-custom input[type="checkbox"] {
        accent-color: var(--vp-red);
        width: 15px;
        height: 15px;
    }

    /* Inline Goods Add Form */
    .goods-form-card {
        background: var(--bg-secondary, #F8FAFC);
        border: 1.5px dashed var(--border-color, #CBD5E1);
        border-radius: 8px;
        padding: 1rem;
        margin-bottom: 1rem;
    }

    .goods-inline-row {
        display: grid;
        grid-template-columns: 80px 1.2fr 1fr;
        gap: 0.5rem;
        margin-top: 0.5rem;
    }

    .btn-add-goods {
        width: 100%;
        background: var(--card-bg, white);
        border: 1.5px solid var(--vp-red);
        color: var(--vp-red);
        border-radius: 6px;
        padding: 0.6rem;
        font-weight: 700;
        font-size: 0.85rem;
        cursor: pointer;
        transition: all 0.2s;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 0.4rem;
        margin-top: 0.75rem;
    }

    .btn-add-goods:hover {
        background: rgba(37, 99, 235, 0.05);
        box-shadow: 0 2px 8px rgba(37, 99, 235, 0.1);
    }

    .added-product-row {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 0.85rem;
        border-radius: 6px;
        background: var(--bg-secondary, #F8FAFC);
        border: 1px solid var(--vp-border);
        margin-bottom: 0.5rem;
        font-size: 0.85rem;
    }

    .prod-details h4 {
        margin: 0 0 0.15rem 0;
        font-size: 0.9rem;
        font-weight: 700;
    }

    .prod-details p {
        margin: 0;
        color: var(--vp-text-muted);
        font-weight: 550;
    }

    .qty-counter {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        background: var(--card-bg, white);
        border: 1px solid var(--vp-border);
        border-radius: 4px;
        padding: 0.15rem 0.35rem;
    }

    .counter-btn {
        background: transparent;
        border: none;
        font-weight: 800;
        cursor: pointer;
        width: 20px;
        height: 20px;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: color 0.2s;
    }

    .counter-btn:hover {
        color: var(--vp-red);
    }

    .counter-val {
        font-weight: 700;
        min-width: 15px;
        text-align: center;
    }

    /* Fixed Sticky Bottom Bar matching exactly the screenshot style */
    .sticky-bottom-bar {
        position: fixed;
        bottom: 0;
        left: 0;
        right: 0;
        background: var(--navbar-bg, rgba(255, 255, 255, 0.95));
        backdrop-filter: blur(10px);
        -webkit-backdrop-filter: blur(10px);
        border-top: 1.5px solid var(--border-color, var(--vp-border));
        padding: 0.75rem 2rem;
        z-index: 1000;
        box-shadow: 0 -4px 20px rgba(0, 0, 0, 0.15);
    }

    .sticky-content {
        max-width: 1400px;
        margin: 0 auto;
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .sticky-summary-block {
        display: flex;
        gap: 2rem;
    }

    .sticky-summary-item {
        display: flex;
        flex-direction: column;
        gap: 0.15rem;
    }

    .sticky-summary-lbl {
        font-size: 0.75rem;
        font-weight: 700;
        color: var(--vp-text-muted);
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }

    .sticky-summary-val {
        font-size: 1.25rem;
        font-weight: 850;
        color: var(--vp-red);
    }

    .sticky-actions-block {
        display: flex;
        align-items: center;
        gap: 1.25rem;
    }

    .checkbox-agreement {
        display: flex;
        align-items: center;
        gap: 0.4rem;
        font-size: 0.825rem;
        font-weight: 600;
        cursor: pointer;
    }

    .checkbox-agreement input {
        accent-color: var(--vp-red);
        width: 15px;
        height: 15px;
    }

    .btn-create-order {
        background: var(--vp-red);
        color: white;
        border: none;
        padding: 0.75rem 2.25rem;
        border-radius: 6px;
        font-weight: 750;
        font-size: 0.9rem;
        cursor: pointer;
        box-shadow: 0 4px 10px rgba(227, 6, 19, 0.2);
        transition: all 0.2s;
    }

    .btn-create-order:hover {
        background: var(--vp-red-hover);
        transform: translateY(-1px);
    }

    .btn-draft-custom {
        background: #64748B;
        color: white;
        border: none;
        padding: 0.75rem 1.75rem;
        border-radius: 6px;
        font-weight: 750;
        font-size: 0.9rem;
        cursor: pointer;
        transition: background 0.2s;
    }

    .btn-draft-custom:hover {
        background: #475569;
    }

    .btn-reset-custom {
        background: #E2E8F0;
        color: #334155;
        border: none;
        padding: 0.75rem 1.50rem;
        border-radius: 6px;
        font-weight: 750;
        font-size: 0.9rem;
        cursor: pointer;
        transition: all 0.2s;
    }

    .btn-reset-custom:hover {
        background: #CBD5E1;
    }

    /* Premium Catalog Modal Styling */
    .modal-overlay-custom {
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background: rgba(15, 23, 42, 0.4);
        backdrop-filter: blur(8px);
        -webkit-backdrop-filter: blur(8px);
        z-index: 2000;
        display: none;
        align-items: center;
        justify-content: center;
        padding: 1.5rem;
    }

    .modal-content-custom {
        background: var(--card-bg, white);
        border-radius: 10px;
        width: 100%;
        max-width: 600px;
        box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.15), 0 10px 10px -5px rgba(0, 0, 0, 0.08);
        border: 1px solid var(--vp-border);
        overflow: hidden;
        display: flex;
        flex-direction: column;
        max-height: 80vh;
        animation: modalFadeIn 0.25s ease;
    }

    @@keyframes modalFadeIn {
        from { transform: scale(0.96); opacity: 0; }
        to { transform: scale(1); opacity: 1; }
    }

    .modal-header-custom {
        padding: 1.25rem 1.5rem;
        border-bottom: 1.5px solid var(--border-color, #F1F5F9);
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .modal-title-custom {
        font-size: 1rem;
        font-weight: 850;
        color: var(--vp-text-dark);
        text-transform: uppercase;
        letter-spacing: 0.5px;
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }

    .modal-title-custom i {
        color: var(--vp-red);
    }

    .modal-close-btn {
        background: transparent;
        border: none;
        font-size: 1.25rem;
        color: var(--text-light, #94A3B8);
        cursor: pointer;
        transition: color 0.2s;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .modal-close-btn:hover {
        color: var(--vp-red);
    }

    .modal-body-custom {
        padding: 1.25rem 1.5rem;
        overflow-y: auto;
        flex: 1;
        background: var(--bg-secondary, #F8FAFC);
    }

    .modal-search-wrapper {
        margin-bottom: 1.25rem;
        position: sticky;
        top: 0;
        z-index: 10;
        background: var(--bg-secondary, #F8FAFC);
        padding-bottom: 0.5rem;
    }

    .catalog-goods-grid {
        display: flex;
        flex-direction: column;
        gap: 0.75rem;
    }

    .catalog-item-card {
        background: var(--card-bg, white);
        border: 1.5px solid var(--vp-border);
        border-radius: 8px;
        padding: 1rem;
        transition: all 0.2s;
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 1rem;
    }

    .catalog-item-card:hover {
        border-color: var(--vp-red);
        box-shadow: 0 4px 12px rgba(37, 99, 235, 0.08);
        transform: translateY(-1px);
    }

    .catalog-item-info {
        flex: 1;
    }

    .catalog-item-info h4 {
        margin: 0 0 0.25rem 0;
        font-size: 0.9rem;
        font-weight: 750;
        color: var(--vp-text-dark);
    }

    .catalog-item-info p {
        margin: 0 0 0.2rem 0;
        font-size: 0.8rem;
        color: var(--vp-text-muted);
        font-weight: 550;
    }

    .catalog-item-info .catalog-tag {
        display: inline-block;
        background: var(--bg-secondary, #F1F5F9);
        color: var(--text-muted, #475569);
        font-size: 0.7rem;
        font-weight: 700;
        padding: 0.15rem 0.4rem;
        border-radius: 4px;
        text-transform: uppercase;
    }

    .catalog-item-actions {
        display: flex;
        gap: 0.4rem;
    }

    .btn-catalog-select {
        background: var(--card-bg, white);
        border: 1.5px solid var(--border-color, #CBD5E1);
        color: var(--text-muted, #475569);
        padding: 0.45rem 0.85rem;
        border-radius: 6px;
        font-weight: 700;
        font-size: 0.775rem;
        cursor: pointer;
        transition: all 0.2s;
    }

    .btn-catalog-select:hover {
        border-color: var(--vp-red);
        color: var(--vp-red);
        background: rgba(37, 99, 235, 0.04);
    }

    .btn-catalog-add {
        background: var(--vp-red);
        border: none;
        color: white;
        padding: 0.45rem 0.85rem;
        border-radius: 6px;
        font-weight: 700;
        font-size: 0.775rem;
        cursor: pointer;
        transition: all 0.2s;
    }

    .btn-catalog-add:hover {
        background: var(--vp-red-hover);
        box-shadow: 0 2px 8px rgba(227, 6, 19, 0.15);
    }
</style>

<div class="order-container">
    <!-- Header -->
    <div class="order-header-bar">
        <a asp-action="Orders" class="back-btn">
            <i class="fas fa-chevron-left" style="font-size: 0.9rem;"></i> Tạo đơn
        </a>
        <div style="font-size: 0.8rem; font-weight: 600; color: var(--vp-text-muted);">
            Lưu ý: (*) Là các trường bắt buộc nhập
        </div>
    </div>

    <!-- Main Redesigned Form matching screenshot -->
    <form id="create-order-form" asp-action="CreateOrder" method="post">
        @Html.AntiForgeryToken()
        
        <!-- Address elements combined in background -->
        <input type="hidden" asp-for="DiaChiNguoiNhan" id="full-address-hidden" />
        <input type="hidden" asp-for="TongKhoiLuong" id="total-weight-hidden" />
        <input type="hidden" asp-for="HinhThucThanhToan" id="payment-method-hidden" value="COD" />

        <div class="form-grid">
            
            <!-- LEFT COLUMN: SENDER & RECIPIENT -->
            <div>
                <!-- CARD 1: NGƯỜI GỬI -->
                <div class="premium-card">
                    <div class="card-title">
                        <div class="card-title-left">
                            <i class="fas fa-circle-chevron-right"></i> Người gửi
                        </div>
                        <a href="javascript:void(0)" onclick="alert('Quản lý thông tin địa chỉ người gửi hàng')" style="font-size: 0.8rem; color: var(--vp-red); font-weight: 700; text-decoration: none; text-transform: none;">
                            Quản lý thông tin người gửi &rarr;
                        </a>
                    </div>

                    <!-- Tùy chọn nơi gửi -->
                    <div class="form-group-custom">
                        <div class="form-label-custom">Tùy chọn nơi gửi*</div>
                        <div class="radio-group-custom">
                            <label class="radio-label-custom">
                                <input type="radio" name="sender-place" value="detail" checked /> Theo địa chỉ KH gửi
                            </label>
                            <label class="radio-label-custom">
                                <input type="radio" name="sender-place" value="smart-box" /> Gửi tại tủ Smart Box
                            </label>
                            <label class="radio-label-custom">
                                <input type="radio" name="sender-place" value="post-office" /> Gửi tại bưu cục
                            </label>
                        </div>
                    </div>

                    <!-- Chọn thông tin người gửi -->
                    <div class="form-group-custom">
                        <div class="select-custom-wrapper">
                            <select id="sender-info-select">
                                <option value="" disabled selected>Chọn thông tin người gửi</option>
                                <option value="primary">Cửa hàng chính (123 Nguyễn Huệ, Q1, TP. HCM)</option>
                                <option value="secondary">Chi nhánh 2 (456 Lê Văn Sỹ, Q3, TP. HCM)</option>
                            </select>
                        </div>
                        <div style="font-size: 0.75rem; color: var(--vp-red); font-weight: 600; margin-top: 0.25rem;">
                            Người gửi không được để trống
                        </div>
                    </div>

                    <!-- Thời gian hẹn lấy -->
                    <div class="form-group-custom">
                        <div class="form-label-custom">Thời gian hẹn lấy</div>
                        <div class="select-custom-wrapper">
                            <select id="sender-pickup-time">
                                <option value="" disabled selected>Chọn thời gian</option>
                                <option value="ca-sang">Ca Sáng (08:00 - 12:00)</option>
                                <option value="ca-chieu">Ca Chiều (13:30 - 17:30)</option>
                            </select>
                        </div>
                    </div>
                </div>

                <!-- CARD 2: NGƯỜI NHẬN -->
                <div class="premium-card">
                    <div class="card-title">
                        <div class="card-title-left">
                            <i class="fas fa-circle-chevron-right"></i> Người nhận
                        </div>
                        <label style="display: flex; align-items: center; gap: 0.35rem; font-size: 0.8rem; font-weight: 700; text-transform: none; cursor: pointer;">
                            <input type="checkbox" style="accent-color: var(--vp-red);" /> Sử dụng địa danh mới
                        </label>
                    </div>

                    <!-- Tùy chọn nơi nhận -->
                    <div class="form-group-custom">
                        <div class="form-label-custom">Tùy chọn nơi nhận*</div>
                        <div class="radio-group-custom">
                            <label class="radio-label-custom">
                                <input type="radio" name="recipient-place" value="detail" checked onchange="selectAddressType('detail')" /> Theo địa chỉ KH nhận
                            </label>
                            <label class="radio-label-custom">
                                <input type="radio" name="recipient-place" value="smart-box" onchange="selectAddressType('smart-box')" /> Nhận tại tủ Smart Box
                            </label>
                            <label class="radio-label-custom">
                                <input type="radio" name="recipient-place" value="post-office" onchange="selectAddressType('post-office')" /> Nhận tại bưu cục
                            </label>
                        </div>
                    </div>

                    <!-- Điện thoại -->
                    <div class="form-group-custom">
                        <div class="form-label-custom">Điện thoại*</div>
                        <div class="input-wrapper-custom">
                            <input type="tel" asp-for="SoDienThoaiNguoiNhan" class="input-field-custom" placeholder="Nhập số điện thoại để tự điền thông tin người nhận" required />
                        </div>
                    </div>

                    <!-- Họ tên -->
                    <div class="form-group-custom">
                        <div class="form-label-custom">Họ tên*</div>
                        <div class="input-wrapper-custom">
                            <input type="text" asp-for="TenNguoiNhan" class="input-field-custom" placeholder="Nhập tên người nhận" required />
                        </div>
                    </div>

                    <!-- Địa chỉ -->
                    <div class="form-group-custom">
                        <div class="form-label-custom">Địa chỉ*</div>
                        <div class="input-wrapper-custom" style="margin-bottom: 0.75rem;">
                            <input type="text" id="addr-house" class="input-field-custom" placeholder="Nhập địa chỉ (Số nhà, Tòa nhà, Hẻm, Ngách, Ngõ)" required oninput="updateCombinedAddress()" />
                        </div>

                        <!-- Dropdown selects matching exactly 2x2 row -->
                        <div class="dropdown-grid">
                            <div class="select-custom-wrapper">
                                <select id="addr-province" required onchange="onProvinceChange()">
                                    <option value="" disabled selected>Tỉnh/Thành phố *</option>
                                    <option value="Hà Nội">Hà Nội</option>
                                    <option value="TP. Hồ Chí Minh">TP. Hồ Chí Minh</option>
                                    <option value="Đà Nẵng">Đà Nẵng</option>
                                    <option value="Bình Dương">Bình Dương</option>
                                </select>
                            </div>
                            <div class="select-custom-wrapper">
                                <select id="addr-district" required disabled onchange="onDistrictChange()">
                                    <option value="" disabled selected>Huyện/Quận *</option>
                                </select>
                            </div>
                        </div>

                        <div class="dropdown-grid">
                            <div class="select-custom-wrapper">
                                <select id="addr-ward" required disabled onchange="updateCombinedAddress()">
                                    <option value="" disabled selected>Xã/Phường *</option>
                                </select>
                            </div>
                            <div class="select-custom-wrapper">
                                <select id="addr-street" onchange="updateCombinedAddress()">
                                    <option value="" selected>Đường/Thôn/Xóm</option>
                                    <option value="Đường Trục Chính">Đường Trục Chính</option>
                                    <option value="Khu Dân Cư Mới">Khu Dân Cư Mới</option>
                                </select>
                            </div>
                        </div>
                    </div>

                    <!-- Thời gian hẹn giao -->
                    <div class="form-group-custom">
                        <div class="form-label-custom">Thời gian hẹn giao</div>
                        <div class="select-custom-wrapper">
                            <select id="recipient-delivery-time">
                                <option value="ca-ngay" selected>Cả ngày</option>
                                <option value="gio-hanh-chinh">Giờ hành chính</option>
                                <option value="buoi-toi">Buổi tối</option>
                            </select>
                        </div>
                    </div>
                </div>

                <!-- CARD 3: CHỌN DỊCH VỤ -->
                <div class="premium-card">
                    <div class="card-title">
                        <div class="card-title-left">
                            <i class="fas fa-circle-chevron-right"></i> Chọn dịch vụ
                        </div>
                    </div>

                    <!-- Dịch vụ chính -->
                    <div class="form-group-custom">
                        <div class="form-label-custom">Dịch vụ chính</div>
                        <div style="display: flex; justify-content: space-between; align-items: center; background: #FFF1F2; padding: 0.85rem 1rem; border-radius: 6px; border: 1.5px solid rgba(227, 6, 19, 0.3);">
                            <div style="display:flex; align-items:center; gap: 0.5rem;">
                                <i class="fas fa-truck-fast" style="color: var(--vp-red); font-size: 1.1rem;"></i>
