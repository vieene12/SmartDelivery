                    </div>

                    <!-- CARD 5: TÍNH CHẤT HÀNG HÓA ĐẶC BIỆT -->
                    <div style="margin-top: 1.5rem; border-top: 1.5px solid #F1F5F9; padding-top: 1.25rem;">
                        <div class="form-label-custom" style="display: flex; align-items: center; gap: 0.25rem;">
                            <i class="fas fa-circle-info" style="color: var(--vp-red);"></i> Tính chất hàng hóa đặc biệt
                        </div>
                        
                        <!-- Checkboxes list -->
                        <div class="checkbox-grid-3col">
                            <label class="checkbox-label-custom">
