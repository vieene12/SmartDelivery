@model SDMS.Models.DonHang
@{
    ViewData["Title"] = "Tra cứu hành trình #" + Model.MaDonHang;
}

<div class="glass" style="max-width: 800px; margin: 0 auto; padding: 3rem; margin-bottom: 2rem;">
    <div id="normal-track-content">
        <div style="display: flex; justify-content: space-between; align-items: center; border-bottom: 1px solid var(--border-color); padding-bottom: 1.5rem; margin-bottom: 2rem; flex-wrap: wrap; gap: 1rem;">
            <div>
                <span style="font-size: 0.8125rem; color: var(--text-muted); text-transform: uppercase; font-weight: 700; display: block;">Mã vận đơn</span>
                <h2 style="font-size: 1.75rem; font-weight: 800; color: var(--accent-primary); margin: 0; font-family: monospace;">@Model.MaDonHang</h2>
        </div>
        <div style="display: flex; gap: 0.75rem;">
            <button onclick="openPrintModal()" class="btn-premium" style="background-color: #10b981 !important; background: linear-gradient(135deg, #10b981, #059669) !important; color: white !important; display: flex; align-items: center; gap: 0.5rem; font-size: 0.875rem; padding: 0.625rem 1.25rem; border-radius: 8px; border: none; cursor: pointer; font-weight: 700;">
                <i class="fas fa-print"></i> In phiếu giao hàng
            </button>
            <a asp-action="Orders" class="btn-premium" style="background: transparent; color: var(--text-main); border: 1px solid var(--border-color); text-decoration: none; padding: 0.625rem 1.25rem; font-size: 0.875rem;">
                <i class="fas fa-arrow-left"></i> Quay lại lịch sử
            </a>
        </div>
    </div>

    <!-- Tóm tắt Đơn Hàng -->
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 1.5rem; margin-bottom: 3rem; background: rgba(0,0,0,0.02); padding: 1.5rem; border-radius: 12px; border: 1px solid var(--border-color);">
        <div>
            <span style="display: block; font-size: 0.75rem; color: var(--text-muted); font-weight: 700; text-transform: uppercase;">Người nhận</span>
            <strong style="color: var(--text-main); font-size: 1rem;">@Model.TenNguoiNhan</strong>
            <span style="display: block; font-size: 0.875rem; color: var(--text-muted);">@Model.SoDienThoaiNguoiNhan</span>
        </div>
        <div>
            <span style="display: block; font-size: 0.75rem; color: var(--text-muted); font-weight: 700; text-transform: uppercase;">Địa chỉ nhận</span>
            <span style="font-size: 0.875rem; color: var(--text-muted); line-height: 1.4; display: block;">@Model.DiaChiNguoiNhan</span>
        </div>
        <div>
            <span style="display: block; font-size: 0.75rem; color: var(--text-muted); font-weight: 700; text-transform: uppercase;">Phí giao hàng & COD</span>
            <strong style="color: var(--text-main); display: block;">@Model.PhiGiaoHang.ToString("N0") VNĐ</strong>
            <span style="font-size: 0.8125rem; background: #eff6ff; color: #1e40af; padding: 0.125rem 0.5rem; border-radius: 4px; display: inline-block; margin-top: 0.25rem;">@Model.HinhThucThanhToan</span>
        </div>
        <div>
            <span style="display: block; font-size: 0.75rem; color: var(--text-muted); font-weight: 700; text-transform: uppercase;">Trạng thái hiện tại</span>
            @{
                var badgeClass = Model.TrangThaiDonHang == "Giao hàng thành công" ? "badge-success" : 
                                (Model.TrangThaiDonHang == "Giao hàng thất bại" ? "badge-error" : "badge-warning");
            }
            <span class="badge @badgeClass" style="margin-top: 0.25rem; display: inline-block;">@Model.TrangThaiDonHang</span>
        </div>
    </div>

    <!-- Timeline Hành Trình -->
    <h3 style="font-size: 1.25rem; font-weight: 800; margin-bottom: 2.5rem; color: var(--text-main); border-bottom: 1px solid var(--border-color); padding-bottom: 0.75rem;">
        <i class="fas fa-route" style="color: var(--accent-primary);"></i> Dòng thời gian Logistics
    </h3>

    <div style="position: relative; padding-left: 2.5rem; margin-left: 1rem; border-left: 2px dashed #cbd5e1;">
        
        <!-- Bước 4: Kết quả giao nhận -->
        @{
            var currentDelivery = Model.HanhTrinhDonHangs.OrderByDescending(h => h.ThoiGianTiepNhan).FirstOrDefault();
            if (currentDelivery != null && (currentDelivery.TrangThai == "Giao hàng thành công" || currentDelivery.TrangThai == "Giao hàng thất bại"))
            {
                var isSuccess = currentDelivery.TrangThai == "Giao hàng thành công";
                var iconColor = isSuccess ? "#16a34a" : "#dc2626";
                var iconClass = isSuccess ? "fa-check-circle" : "fa-times-circle";
                
                <div style="position: relative; margin-bottom: 2.5rem;">
                    <div style="position: absolute; left: -3.5rem; top: 0; width: 2rem; height: 2rem; border-radius: 50%; background: white; border: 2px solid @iconColor; display: flex; align-items: center; justify-content: center; z-index: 2;">
                        <i class="fas @iconClass" style="color: @iconColor; font-size: 1rem;"></i>
                    </div>
                    <div class="glass" style="padding: 1.25rem; border-left: 4px solid @iconColor;">
                        <span style="font-size: 0.75rem; color: var(--text-muted); font-weight: 600;">@currentDelivery.ThoiGianHoanThanh?.ToString("dd/MM/yyyy HH:mm")</span>
                        <h4 style="font-size: 1rem; font-weight: 700; margin: 0.25rem 0 0.5rem 0; color: var(--text-main);">@currentDelivery.TrangThai</h4>
                        <div style="font-size: 0.875rem; color: var(--text-muted);">
                            <div><i class="fas fa-map-marker-alt" style="color: @iconColor;"></i> Vị trí: @currentDelivery.ViTriHienTai</div>
                            @if (!isSuccess && !string.IsNullOrEmpty(currentDelivery.LyDoThatBai))
                            {
                                <div style="background: #fff5f5; color: #991b1b; padding: 0.5rem; border-radius: 6px; margin-top: 0.5rem; border: 1px solid #fecaca;">
                                    <strong>Lý do thất bại:</strong> @currentDelivery.LyDoThatBai
                                </div>
                            }
                            @if (!string.IsNullOrEmpty(currentDelivery.HinhAnhThucTe))
                            {
                                <div style="margin-top: 0.75rem;">
                                    <span style="display:block; font-size: 0.75rem; color: var(--text-muted); font-weight: 600; margin-bottom: 0.25rem;">Ảnh chụp minh chứng thực tế:</span>
                                    <img src="@currentDelivery.HinhAnhThucTe" alt="Minh chứng giao hàng" style="max-width: 250px; border-radius: 8px; border: 1px solid var(--border-color); box-shadow: 0 4px 6px -1px rgba(0,0,0,0.05);" />
                                </div>
                            }
                        </div>
                    </div>
                </div>
            }
        }

        <!-- Bước 3: Đang giao hàng / Bàn giao Shipper -->
        @if (currentDelivery != null)
        {
            <div style="position: relative; margin-bottom: 2.5rem;">
                <div style="position: absolute; left: -3.5rem; top: 0; width: 2rem; height: 2rem; border-radius: 50%; background: white; border: 2px solid var(--accent-primary); display: flex; align-items: center; justify-content: center; z-index: 2;">
                    <i class="fas fa-shipping-fast" style="color: var(--accent-primary); font-size: 0.875rem;"></i>
                </div>
                <div class="glass" style="padding: 1.25rem; border-left: 4px solid var(--accent-primary);">
                    <span style="font-size: 0.75rem; color: var(--text-muted); font-weight: 600;">@currentDelivery.ThoiGianTiepNhan.ToString("dd/MM/yyyy HH:mm")</span>
                    <h4 style="font-size: 1rem; font-weight: 700; margin: 0.25rem 0 0.5rem 0; color: var(--text-main);">Tiếp nhận vận chuyển (Shipper)</h4>
                    <p style="margin: 0; font-size: 0.875rem; color: var(--text-muted);">
                        Nhân viên giao hàng <strong>@currentDelivery.NhanVien?.HoTen</strong> (@currentDelivery.NhanVien?.SoDienThoai) đã nhận bàn giao kiện hàng và đang tiến hành vận chuyển.
                    </p>
                </div>
            </div>
        }

        <!-- Bước 2: Nhập kho bưu cục & Đối soát kiểm định -->
        @{
            var storageRecord = Model.NhapKhos.OrderByDescending(n => n.ThoiGianNhap).FirstOrDefault();
            if (storageRecord != null)
            {
                <div style="position: relative; margin-bottom: 2.5rem;">
                    <div style="position: absolute; left: -3.5rem; top: 0; width: 2rem; height: 2rem; border-radius: 50%; background: var(--bg-body); border: 2px solid var(--color-warning); display: flex; align-items: center; justify-content: center; z-index: 2;">
                        <i class="fas fa-warehouse" style="color: var(--color-warning); font-size: 0.875rem;"></i>
                    </div>
                    <div class="glass" style="padding: 1.25rem; border-left: 4px solid var(--color-warning);">
                        <span style="font-size: 0.75rem; color: var(--text-muted); font-weight: 600;">@storageRecord.ThoiGianNhap.ToString("dd/MM/yyyy HH:mm")</span>
                        <h4 style="font-size: 1rem; font-weight: 700; margin: 0.25rem 0 0.5rem 0; color: var(--text-main);">Đã kiểm định & Nhập kho</h4>
                        <div style="font-size: 0.875rem; color: var(--text-muted); line-height: 1.5;">
                            <div>Bưu cục lưu trữ: <strong>@storageRecord.KhoHang?.TenKho</strong> (Vị trí kệ: <code>@storageRecord.ViTriLuuTru</code>)</div>
                            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.5rem; margin-top: 0.5rem; background: var(--bg-body-secondary); padding: 0.75rem; border-radius: 6px; font-size: 0.8125rem;">
                                <div>⚖️ Cân nặng thực tế: <strong>@storageRecord.KhoiLuongThucTe kg</strong></div>
                                <div>📦 Số kiện nhận: <strong>@storageRecord.SoLuongKienHang</strong></div>
                                <div style="grid-column: span 2;">📝 Tình trạng kiểm định: <em>@storageRecord.TinhTrangDonHang</em></div>
                            </div>
                            <div style="font-size: 0.8125rem; margin-top: 0.5rem; color: var(--text-muted);">
                                Tiếp nhận bởi Thủ kho: <strong>@storageRecord.NhanVien?.HoTen</strong>
                            </div>
                        </div>
                    </div>
                </div>
            }
        }

        <!-- Bước 1: Khởi tạo đơn hàng -->
        <div style="position: relative; margin-bottom: 1rem;">
            <div style="position: absolute; left: -3.5rem; top: 0; width: 2rem; height: 2rem; border-radius: 50%; background: white; border: 2px solid #94a3b8; display: flex; align-items: center; justify-content: center; z-index: 2;">
                <i class="fas fa-box" style="color: #94a3b8; font-size: 0.875rem;"></i>
            </div>
            <div class="glass" style="padding: 1.25rem; border-left: 4px solid #94a3b8;">
                <span style="font-size: 0.75rem; color: var(--text-muted); font-weight: 600;">@Model.ThoiGianTao.ToString("dd/MM/yyyy HH:mm")</span>
                <h4 style="font-size: 1rem; font-weight: 700; margin: 0.25rem 0 0.5rem 0; color: var(--text-main);">Khởi tạo vận đơn</h4>
                <p style="margin: 0; font-size: 0.875rem; color: var(--text-muted);">
                    Khách hàng <strong>@Model.KhachHang?.HoTen</strong> tạo vận đơn trực tuyến thành công. Trạng thái: Chờ mang hàng đến bưu cục.
                </p>
            </div>
        </div>

        </div>
    </div>
</div>

<!-- Beautiful Print Modal Overlay -->
<div id="print-label-modal" style="display: none; position: fixed; top: 0; left: 0; width: 100vw; height: 100vh; background: rgba(15, 23, 42, 0.8); backdrop-filter: blur(12px); z-index: 10000; align-items: center; justify-content: center; opacity: 0; transition: opacity 0.3s ease;">
    <div class="glass" style="width: 90%; max-width: 550px; padding: 2rem; position: relative; border-radius: 1.5rem; box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.3); border: 1px solid rgba(255, 255, 255, 0.1); background: var(--card-bg);">
        
        <!-- Header -->
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.5rem; border-bottom: 1px solid var(--border-color); padding-bottom: 1rem;">
            <h3 style="margin: 0; font-size: 1.25rem; font-weight: 800; color: var(--text-main); display: flex; align-items: center; gap: 0.5rem;">
                <i class="fas fa-print" style="color: var(--accent-primary);"></i> Xem trước phiếu giao hàng
            </h3>
            <button onclick="closePrintModal()" style="background: var(--card-bg); border: 1px solid var(--border-color); color: var(--text-main); border-radius: 50%; width: 32px; height: 32px; cursor: pointer; display: flex; align-items: center; justify-content: center; transition: background 0.2s;">
                <i class="fas fa-times"></i>
            </button>
        </div>

        <!-- Printable Label Area -->
        <div style="overflow-y: auto; max-height: 60vh; padding: 0.5rem; border: 1px dashed #94a3b8; border-radius: 12px; margin-bottom: 1.5rem; background: white;">
            <div id="shipping-label-print-area" style="padding: 1.5rem; font-family: 'Inter', sans-serif; color: black; background: white; line-height: 1.4; font-size: 0.85rem; border: 1px solid black; border-radius: 0; text-align: left;">
                
                <!-- Brand & Logo -->
                <div style="display: flex; justify-content: space-between; align-items: center; border-bottom: 2px solid black; padding-bottom: 0.75rem; margin-bottom: 0.75rem;">
                    <div style="display: flex; align-items: center; gap: 0.5rem;">
                        <svg viewBox="0 0 32 32" fill="none" xmlns="http://www.w3.org/2000/svg" style="width: 28px; height: 28px;">
                            <path d="M16 2L3 9.5v13L16 30l13-7.5v-13L16 2z" fill="#2563eb" fill-opacity="0.15" stroke="#2563eb" stroke-width="2" stroke-linejoin="round" />
                            <path d="M16 2L3 9.5M16 2l13 7.5M16 2v28M3 9.5l13 7.5M29 9.5l-13 7.5" stroke="#2563eb" stroke-width="1.5" stroke-linejoin="round" opacity="0.6" />
                            <path d="M11 12.5h5.5l-3.5 3.5h5L14 20" stroke="#ff6b35" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" />
                        </svg>
                        <span style="font-size: 1.2rem; font-weight: 850; color: #2563eb; letter-spacing: -0.04em;">SmartDelivery</span>
                    </div>
                    <div style="text-align: right;">
                        <span style="font-size: 0.7rem; font-weight: 700; text-transform: uppercase; color: #64748b; display: block;">Ngày tạo đơn</span>
                        <strong style="font-size: 0.8rem; color: black;">@Model.ThoiGianTao.ToString("dd/MM/yyyy")</strong>
                    </div>
                </div>

                <!-- Barcode & Tracking Number -->
                <div style="display: flex; flex-direction: column; align-items: center; justify-content: center; margin-bottom: 1rem; border-bottom: 1px solid black; padding-bottom: 1rem;">
                    <!-- Custom Pure CSS Barcode Mockup -->
                    <div style="display: flex; height: 45px; width: 100%; max-width: 280px; background: white; padding: 2px; align-items: stretch; justify-content: space-between;">
                        <div style="width: 4px; background: black;"></div><div style="width: 2px; background: white;"></div>
                        <div style="width: 2px; background: black;"></div><div style="width: 3px; background: white;"></div>
                        <div style="width: 6px; background: black;"></div><div style="width: 2px; background: white;"></div>
                        <div style="width: 1px; background: black;"></div><div style="width: 4px; background: white;"></div>
                        <div style="width: 5px; background: black;"></div><div style="width: 1px; background: white;"></div>
                        <div style="width: 2px; background: black;"></div><div style="width: 3px; background: white;"></div>
                        <div style="width: 8px; background: black;"></div><div style="width: 2px; background: white;"></div>
                        <div style="width: 3px; background: black;"></div><div style="width: 4px; background: white;"></div>
                        <div style="width: 1px; background: black;"></div><div style="width: 2px; background: white;"></div>
                        <div style="width: 4px; background: black;"></div><div style="width: 3px; background: white;"></div>
                        <div style="width: 7px; background: black;"></div><div style="width: 1px; background: white;"></div>
                        <div style="width: 2px; background: black;"></div><div style="width: 4px; background: white;"></div>
                        <div style="width: 5px; background: black;"></div><div style="width: 2px; background: white;"></div>
                        <div style="width: 3px; background: black;"></div><div style="width: 3px; background: white;"></div>
                        <div style="width: 6px; background: black;"></div>
                    </div>
                    <strong style="font-size: 1.15rem; letter-spacing: 0.05em; font-family: monospace; margin-top: 0.25rem; color: black;">@Model.MaDonHang</strong>
                </div>

                <!-- Sender vs Receiver grid -->
                <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; border-bottom: 1px solid black; padding-bottom: 0.75rem; margin-bottom: 0.75rem;">
                    <div style="border-right: 1px solid black; padding-right: 0.5rem; text-align: left;">
                        <span style="font-size: 0.65rem; font-weight: 800; text-transform: uppercase; color: #475569; display: block; margin-bottom: 0.25rem;">TỪ (NGƯỜI GỬI)</span>
                        <strong style="font-size: 0.85rem; display: block; color: black;">@Model.KhachHang?.HoTen</strong>
                        <span style="font-size: 0.8rem; display: block; font-family: monospace; font-weight: 600; color: black;">@Model.KhachHang?.SoDienThoai</span>
                        <span style="font-size: 0.75rem; color: #334155; display: block; line-height: 1.3; margin-top: 0.25rem;">@Model.KhachHang?.DiaChi</span>
                    </div>
                    <div style="padding-left: 0.25rem; text-align: left;">
                        <span style="font-size: 0.65rem; font-weight: 800; text-transform: uppercase; color: #475569; display: block; margin-bottom: 0.25rem;">ĐẾN (NGƯỜI NHẬN)</span>
                        <strong style="font-size: 0.9rem; display: block; color: black;">@Model.TenNguoiNhan</strong>
                        <span style="font-size: 0.85rem; display: block; font-family: monospace; font-weight: 700; color: black;">@Model.SoDienThoaiNguoiNhan</span>
                        <span style="font-size: 0.78rem; color: #334155; display: block; line-height: 1.3; margin-top: 0.25rem; font-weight: 600;">@Model.DiaChiNguoiNhan</span>
                    </div>
                </div>

                <!-- Package list -->
                <div style="border-bottom: 1px solid black; padding-bottom: 0.75rem; margin-bottom: 0.75rem;">
                    <span style="font-size: 0.65rem; font-weight: 800; text-transform: uppercase; color: #475569; display: block; margin-bottom: 0.4rem; text-align: left;">NỘI DUNG HÀNG HÓA</span>
                    <table style="width: 100%; border-collapse: collapse; font-size: 0.78rem; text-align: left; color: black;">
                        <thead>
                            <tr style="border-bottom: 1px solid black;">
                                <th style="padding: 0.25rem 0; font-weight: 700; text-align: left; color: black;">Tên hàng hóa</th>
                                <th style="padding: 0.25rem 0; text-align: center; font-weight: 700; width: 40px; color: black;">SL</th>
                                <th style="padding: 0.25rem 0; text-align: right; font-weight: 700; width: 80px; color: black;">Khối lượng</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.ChiTietDonHangs != null && Model.ChiTietDonHangs.Any())
                            {
                                foreach (var item in Model.ChiTietDonHangs)
                                {
                                    <tr style="border-bottom: 1px dashed #e2e8f0;">
                                        <td style="padding: 0.35rem 0; color: black; text-align: left;">@item.HangHoa?.TenHangHoa</td>
                                        <td style="padding: 0.35rem 0; text-align: center; color: black;">@item.SoLuong</td>
                                        <td style="padding: 0.35rem 0; text-align: right; color: black;">@((item.HangHoa?.KhoiLuong ?? 0) * item.SoLuong) kg</td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr style="border-bottom: 1px dashed #e2e8f0;">
                                    <td style="padding: 0.35rem 0; color: black; text-align: left;">Bưu phẩm vận tải</td>
                                    <td style="padding: 0.35rem 0; text-align: center; color: black;">1</td>
                                    <td style="padding: 0.35rem 0; text-align: right; color: black;">@Model.TongKhoiLuong kg</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <!-- COD / Cost Summary -->
                <div style="display: grid; grid-template-columns: 1.2fr 0.8fr; gap: 1rem; border-bottom: 1px solid black; padding-bottom: 0.75rem; margin-bottom: 0.75rem; align-items: center;">
                    <div style="text-align: left;">
                        <div style="font-size: 0.65rem; font-weight: 800; text-transform: uppercase; color: #475569;">HÌNH THỨC THANH TOÁN</div>
                        <strong style="font-size: 0.8rem; display: block; margin-top: 0.15rem; color: black;">@Model.HinhThucThanhToan</strong>
                    </div>
                    <div style="text-align: right; border-left: 1px solid black; padding-left: 0.5rem;">
                        <div style="font-size: 0.65rem; font-weight: 800; text-transform: uppercase; color: #475569;">TIỀN THU HỘ (COD)</div>
                        <strong style="font-size: 1.15rem; font-weight: 850; color: black; display: block; margin-top: 0.15rem;">
                            @Model.PhiGiaoHang.ToString("N0") đ
                        </strong>
                    </div>
                </div>

                <!-- Footer Bill Checkbox / Signature Box -->
                <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; text-align: center; font-size: 0.75rem; margin-top: 0.5rem; height: 75px; align-items: stretch; color: black;">
                    <div style="border-right: 1px dashed black; display: flex; flex-direction: column; justify-content: space-between;">
                        <span style="font-weight: 700; color: black;">Chữ ký người gửi</span>
                        <em style="font-size: 0.65rem; color: #64748b;">(Ký và ghi rõ họ tên)</em>
                    </div>
                    <div style="display: flex; flex-direction: column; justify-content: space-between;">
                        <span style="font-weight: 700; color: black;">Chữ ký người nhận</span>
                        <em style="font-size: 0.65rem; color: #64748b;">(Xác nhận hàng nguyên vẹn)</em>
                    </div>
                </div>
            </div>
        </div>

        <!-- Actions -->
        <div style="display: flex; gap: 1rem; justify-content: flex-end;">
            <button onclick="closePrintModal()" class="btn-premium" style="background: transparent; color: var(--text-main); border: 1px solid var(--border-color); cursor: pointer; padding: 0.625rem 1.25rem; border-radius: 8px;">Đóng</button>
            <button onclick="triggerBrowserPrint()" class="btn-premium" style="background-color: #10b981 !important; background: linear-gradient(135deg, #10b981, #059669) !important; color: white !important; display: flex; align-items: center; gap: 0.5rem; border: none; cursor: pointer; font-weight: 700; padding: 0.625rem 1.25rem; border-radius: 8px;">
                <i class="fas fa-print"></i> Tiến hành in phiếu
            </button>
        </div>
    </div>
</div>

<style>
    .print-modal-active {
        opacity: 1 !important;
        pointer-events: auto !important;
    }
    
    @@media print {
        /* Hide layout items and normal page content completely */
        .sidebar, .navbar, .footer-section, .btn-premium, #normal-track-content, hr, br {
            display: none !important;
        }

        /* Show body and enable printing */
        body {
            background: white !important;
            color: black !important;
        }

        /* Reset the glass wrapper of the main content so it doesn't display any styles */
        .main-container, .glass {
            background: transparent !important;
            border: none !important;
            box-shadow: none !important;
            padding: 0 !important;
            margin: 0 !important;
            backdrop-filter: none !important;
            -webkit-backdrop-filter: none !important;
        }

        /* Style the modal overlay container to act as a normal block, removing fixed overlays */
        #print-label-modal {
            display: block !important;
            position: relative !important;
            top: 0 !important;
            left: 0 !important;
            width: 100% !important;
            height: auto !important;
            background: white !important;
            backdrop-filter: none !important;
            -webkit-backdrop-filter: none !important;
            opacity: 1 !important;
            z-index: 1000 !important;
            padding: 0 !important;
            margin: 0 !important;
        }

        #print-label-modal > .glass {
            background: white !important;
            border: none !important;
            box-shadow: none !important;
            padding: 0 !important;
            margin: 0 auto !important;
            width: 100% !important;
            max-width: 100% !important;
        }

        /* Hide modal controls: close button, modal headers, modal footer buttons */
        #print-label-modal button,
        #print-label-modal h3,
        #print-label-modal div[style*="justify-content: space-between"],
        #print-label-modal div[style*="justify-content: flex-end"] {
            display: none !important;
        }

        /* Center and display only the label itself */
        #shipping-label-print-area {
            position: relative !important;
            left: auto !important;
            top: 40px !important;
            transform: none !important;
            width: 100% !important;
            max-width: 480px !important;
            margin: 0 auto !important;
            border: 2px solid black !important;
            padding: 1.5rem !important;
            box-shadow: none !important;
            background: white !important;
            box-sizing: border-box !important;
            z-index: 100000 !important;
        }
    }
</style>

<script>
    const openPrintModal = () => {
        const modal = document.getElementById('print-label-modal');
        modal.style.display = 'flex';
        setTimeout(() => modal.classList.add('print-modal-active'), 50);
    };

    const closePrintModal = () => {
        const modal = document.getElementById('print-label-modal');
        modal.classList.remove('print-modal-active');
        setTimeout(() => modal.style.display = 'none', 300);
    };

    const triggerBrowserPrint = () => {
        // Tải trang in chuyên dụng vào một iframe ẩn ở nền (không nhảy tab mới, không pop-up)
        let iframe = document.getElementById('print-label-iframe');
        if (!iframe) {
            iframe = document.createElement('iframe');
            iframe.id = 'print-label-iframe';
            iframe.style.position = 'fixed';
            iframe.style.width = '0';
            iframe.style.height = '0';
            iframe.style.border = 'none';
            iframe.style.visibility = 'hidden';
            document.body.appendChild(iframe);
        }
        
        // Đặt nguồn là trang in nhãn để trình in tự động kích hoạt ngay trong tab hiện tại
        iframe.src = '/Customer/PrintLabel/@Model.MaDonHang';
    };

    document.addEventListener('DOMContentLoaded', function() {
        const urlParams = new URLSearchParams(window.location.search);
        if (urlParams.get('print') === 'true') {
            setTimeout(openPrintModal, 500);
        }
    });
</script>
