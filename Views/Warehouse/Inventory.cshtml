@model IEnumerable<SDMS.Models.NhapKho>
@{
    ViewData["Title"] = "Warehouse Inventory Control";
}

<div class="glass" style="padding: 1.5rem;">
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 2rem;">
        <h2 style="font-size: 1.25rem; font-weight: 600; margin: 0;">Quản lý tồn kho bưu cục</h2>
        <div style="display: flex; gap: 1rem;">
            <input type="text" class="glass" style="padding: 0.5rem 1rem; border: 1px solid var(--border-color); color: var(--text-main); background: var(--card-bg);" placeholder="Tìm mã kho / mã đơn..." />
            <button class="btn-premium">Lọc</button>
        </div>
    </div>

    <table class="premium-table">
        <thead>
            <tr>
                <th>Mã lưu kho</th>
                <th>Mã đơn hàng</th>
                <th>Bưu cục / Kho</th>
                <th>Vị trí kệ</th>
                <th>Số kiện</th>
                <th>KL thực tế</th>
                <th>Tình trạng đơn hàng</th>
                <th>Thời gian nhập</th>
                <th>Thủ kho tiếp nhận</th>
                <th>Trạng thái</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td style="font-size: 0.875rem; color: var(--text-muted); font-family: monospace;">@item.MaNhapKho</td>
                    <td style="font-weight: 700; color: #ef4444; font-family: monospace;">@item.MaDonHang</td>
                    <td>@item.KhoHang?.TenKho</td>
                    <td><span style="font-family: monospace; background: var(--border-color); color: var(--text-main); padding: 0.25rem 0.5rem; border-radius: 4px;">@item.ViTriLuuTru</span></td>
                    <td>@(item.SoLuongKienHang ?? 1)</td>
                    <td>@(item.KhoiLuongThucTe ?? 0) kg</td>
                    <td style="font-size: 0.875rem; max-width: 200px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;" title="@item.TinhTrangDonHang">@item.TinhTrangDonHang</td>
                    <td>@item.ThoiGianNhap.ToString("dd/MM/yyyy HH:mm")</td>
                    <td>@item.NhanVien?.HoTen</td>
                    <td><span class="badge badge-success">@item.TrangThaiKho</span></td>
                </tr>
            }
            @if (!Model.Any())
            {
                <tr>
                    <td colspan="10" style="text-align: center; padding: 3rem; color: var(--text-muted);">
                        Kho hàng trống. Hãy bắt đầu nhận hàng để kiểm tra tồn kho bãi.
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
