    <p style="color: var(--text-muted); max-width: 620px; margin: 0.75rem auto 2rem; line-height: 1.7; font-weight: 550; font-size: 1.05rem;">SmartDelivery cung cấp các gói đặc quyền chiết khấu trực tiếp lên đến <strong>30%</strong> trên tổng cước phí bưu gửi và miễn phí thu hộ COD dành riêng cho các đối tác lâu năm.</p>
    <a asp-controller="Customer" asp-action="CreateOrder" class="btn-premium" style="text-decoration: none; padding: 0.9rem 2.5rem; border-radius: var(--radius-sm); font-size: 0.95rem;">
        <i class="fas fa-handshake"></i> Liên hệ hợp tác ngay
    </a>
</div>

@section Scripts {
    <script>
        // Define initial active tab from controller ViewBag
        const initialTab = '@activeTab';

        function switchTab(tabId) {
            // Remove active class from all tab buttons
            document.querySelectorAll('.tab-btn').forEach(btn => {
                btn.classList.remove('active');
            });
            
            // Remove active class from all pricing panes
            document.querySelectorAll('.pricing-pane').forEach(pane => {
                pane.classList.remove('active');
            });
            
            // Add active class to selected tab button & pane
            if (tabId === 'hcm-hn') {
                const btn = document.querySelector('.tab-btn[onclick*="hcm-hn"]');
                if (btn) btn.classList.add('active');
                const pane = document.getElementById('tab-hcm-hn');
                if (pane) pane.classList.add('active');
            } else if (tabId === 'others') {
                const btn = document.querySelector('.tab-btn[onclick*="others"]');
                if (btn) btn.classList.add('active');
                const pane = document.getElementById('tab-others');
                if (pane) pane.classList.add('active');
            }

            // Sync calculator selector with active tab
            const regionSelect = document.getElementById('calc-region');
            if (regionSelect && regionSelect.value !== tabId) {
                regionSelect.value = tabId;
                calculateFee();
            }
        }

        function calculateFee() {
            const region = document.getElementById('calc-region').value;
            const weightInput = document.getElementById('calc-weight');
            let weight = parseFloat(weightInput.value);
            
            if (isNaN(weight) || weight <= 0) {
                weight = 0.1;
            }

            // Pricing rules:
            // hcm-hn: base 25,000 for <= 3kg. Each 0.5kg extra is +5,000
            // others: base 29,000 for <= 3kg. Each 0.5kg extra is +5,000
            let basePrice = region === 'hcm-hn' ? 25000 : 29000;
            let overweightPrice = 0;

            if (weight > 3.0) {
                const extraWeight = weight - 3.0;
                // Calculate number of 0.5kg segments, rounded up
                const segments = Math.ceil(extraWeight / 0.5);
                overweightPrice = segments * 5000;
            }

            const totalPrice = basePrice + overweightPrice;

            // Formatter helper
            const formatter = new Intl.NumberFormat('vi-VN');

            document.getElementById('calc-result-price').innerText = formatter.format(totalPrice);
            document.getElementById('calc-base-price').innerText = formatter.format(basePrice) + 'đ';
            document.getElementById('calc-overweight-price').innerText = formatter.format(overweightPrice) + 'đ';
        }

        document.addEventListener('DOMContentLoaded', function() {
            // Apply initial tab
            switchTab(initialTab);
            calculateFee();

            // Handle dropdown or hash navigation inside the page if any
            window.addEventListener('hashchange', function() {
                const hash = window.location.hash;
                if (hash === '#hcm-hn' || hash === '#others') {
                    switchTab(hash.substring(1));
                }
            });
        });
    </script>
}
