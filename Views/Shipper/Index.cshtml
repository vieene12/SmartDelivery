@{
    ViewData["Title"] = "Điều hành Giao hàng (Shipper)";
}

<div style="margin-bottom: 2.5rem;">
    <h1 style="font-size: 2rem; font-weight: 700; color: var(--text-main); margin: 0;">Chào mừng trở lại, Shipper!</h1>
    <p style="color: var(--text-muted); margin-top: 0.5rem;">Hãy cập nhật hành trình và đảm bảo đơn hàng được giao an toàn, nhanh chóng.</p>
</div>

<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 1.5rem; margin-bottom: 2.5rem;">
    <div class="glass stat-card">
        <div class="stat-card-icon" style="color: var(--primary); background: rgba(37, 99, 235, 0.08);">
            <i class="fas fa-box"></i>
        </div>
        <span class="stat-label">Đơn hàng chờ lấy</span>
        <span class="stat-value">@ViewBag.Stats.AssignedCount</span>
        <div style="color: var(--text-muted); font-size: 0.875rem; margin-top: 0.5rem;">
            <i class="fas fa-barcode"></i> Cần quét mã nhận hàng tại kho
        </div>
    </div>
    
    <div class="glass stat-card">
        <div class="stat-card-icon" style="color: var(--secondary); background: rgba(255, 107, 53, 0.08);">
            <i class="fas fa-shipping-fast"></i>
        </div>
        <span class="stat-label">Đang đi giao</span>
        <span class="stat-value">@ViewBag.Stats.DeliveringCount</span>
        <div style="color: var(--text-muted); font-size: 0.875rem; margin-top: 0.5rem;">
            <i class="fas fa-road"></i> Đang trên đường vận chuyển
        </div>
    </div>
    
    <div class="glass stat-card">
        <div class="stat-card-icon" style="color: #10b981; background: rgba(16, 185, 129, 0.08);">
            <i class="fas fa-check-circle"></i>
        </div>
        <span class="stat-label">Giao thành công hôm nay</span>
        <span class="stat-value">@ViewBag.Stats.CompletedToday</span>
        <div style="color: var(--text-muted); font-size: 0.875rem; margin-top: 0.5rem;">
            <i class="fas fa-award"></i> Hoàn thành tốt ca làm việc
        </div>
    </div>
</div>

<div class="glass" style="padding: 2.5rem; text-align: center; max-width: 800px; margin: 0 auto;">
    <div style="width: 80px; height: 80px; background: var(--accent-secondary); border-radius: 50%; display: flex; align-items: center; justify-content: center; margin: 0 auto 1.5rem;">
        <i class="fas fa-route" style="color: var(--accent-primary); font-size: 2rem;"></i>
    </div>
    <h2 style="font-size: 1.5rem; font-weight: 700; color: var(--text-main); margin-bottom: 1rem;">Nhiệm vụ Giao hàng của bạn</h2>
    <p style="color: var(--text-muted); margin-bottom: 2rem; max-width: 500px; margin-left: auto; margin-right: auto;">
        Truy cập danh sách nhiệm vụ để quét mã QR/mã vạch đơn hàng từ kệ hàng và bắt đầu lộ trình giao hàng của ca trực hôm nay.
    </p>
    <a asp-action="MyDeliveries" class="btn-premium" style="padding: 0.875rem 3rem; text-decoration: none; font-size: 1rem; display: inline-flex; align-items: center; gap: 0.75rem;">
        <i class="fas fa-truck"></i> Xem danh sách giao hàng
    </a>
</div>
