@model IEnumerable<SDMS.Models.KhachHang>
@{
    ViewData["Title"] = "Quản lý Khách hàng";
}

<!-- Tab Navigation Header -->
<div style="display: flex; gap: 0.75rem; margin-bottom: 2.5rem; border-bottom: 1px solid var(--border-color); padding-bottom: 0.75rem;">
    <a asp-action="Staff" class="nav-item" style="text-decoration: none; display: flex; align-items: center; gap: 0.5rem;">
        <i class="fas fa-users-cog"></i> Nhân sự
    </a>
    <a asp-action="Customers" class="nav-item active" style="text-decoration: none; display: flex; align-items: center; gap: 0.5rem;">
        <i class="fas fa-user-friends"></i> Khách hàng
    </a>
    <a asp-action="Warehouses" class="nav-item" style="text-decoration: none; display: flex; align-items: center; gap: 0.5rem;">
        <i class="fas fa-warehouse"></i> Kho bãi
    </a>
    <a asp-action="Categories" class="nav-item" style="text-decoration: none; display: flex; align-items: center; gap: 0.5rem;">
        <i class="fas fa-tags"></i> Nhóm hàng
    </a>
    <a asp-action="Routes" class="nav-item" style="text-decoration: none; display: flex; align-items: center; gap: 0.5rem;">
        <i class="fas fa-route"></i> Tuyến đường
    </a>
    <a asp-action="Shifts" class="nav-item" style="text-decoration: none; display: flex; align-items: center; gap: 0.5rem;">
        <i class="fas fa-calendar-alt"></i> Ca làm việc
    </a>
</div>

<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 2.5rem; flex-wrap: wrap; gap: 1rem;">
    <div>
        <h2 style="font-size: 1.75rem; font-weight: 800; margin: 0; color: var(--text-main);">Danh sách Khách hàng</h2>
        <p style="margin: 0.25rem 0 0 0; color: var(--text-muted); font-size: 0.9375rem;">Theo dõi thông tin khách hàng, lịch sử đơn hàng gửi và quản lý trạng thái tài khoản</p>
    </div>
    
    <div style="display: flex; gap: 0.75rem; align-items: center; flex-wrap: wrap; justify-content: flex-end; width: 100%; max-width: 600px;">
        <!-- Search Bar -->
        <form method="get" asp-action="Customers" style="display: flex; gap: 0.5rem; width: 100%; max-width: 320px; margin: 0;">
            <div class="search-container" style="margin: 0; padding: 0.25rem 0.5rem; flex: 1; display: flex; align-items: center; background: rgba(255, 255, 255, 0.9); border: 1px solid var(--border-color); border-radius: 8px; box-shadow: var(--shadow-sm);">
                <i class="fas fa-search" style="color: var(--text-light); margin-left: 0.75rem; font-size: 0.9rem;"></i>
                <input type="text" name="search" value="@ViewBag.Search" placeholder="Tìm tên, SĐT..." style="border: none; outline: none; padding: 0.5rem 0.75rem; background: transparent; font-size: 0.9rem; width: 100%;" />
                @if (!string.IsNullOrEmpty(ViewBag.Search))
                {
                    <a href="@Url.Action("Customers")" style="color: var(--text-light); margin-right: 0.5rem;" title="Xóa tìm kiếm">
                        <i class="fas fa-times-circle"></i>
                    </a>
                }
            </div>
            <button type="submit" class="btn-premium btn-secondary-premium" style="padding: 0 1rem; border-radius: 8px;">Lọc</button>
        </form>

        <button class="btn-premium" onclick="document.getElementById('add-customer-modal').style.display='flex'" style="border-radius: 8px;">
            <i class="fas fa-plus"></i> Thêm Khách hàng mới
        </button>
    </div>
</div>

<!-- Alert messages -->
@if (TempData["Success"] != null)
{
    <div class="note-banner" style="background-color: rgba(16, 185, 129, 0.07); border: 1px solid rgba(16, 185, 129, 0.25); color: #059669; display: flex; align-items: center; margin: 0 0 2rem 0; padding: 1rem 1.5rem; border-radius: 8px;">
        <i class="fas fa-check-circle" style="font-size: 1.2rem; margin-right: 0.75rem;"></i>
        <span>@TempData["Success"]</span>
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="note-banner" style="background-color: rgba(239, 68, 68, 0.07); border: 1px solid rgba(239, 68, 68, 0.25); color: #dc2626; display: flex; align-items: center; margin: 0 0 2rem 0; padding: 1rem 1.5rem; border-radius: 8px;">
        <i class="fas fa-exclamation-circle" style="font-size: 1.2rem; margin-right: 0.75rem;"></i>
        <span>@TempData["Error"]</span>
    </div>
}

<div class="glass" style="padding: 1.5rem;">
    <table class="premium-table">
        <thead>
            <tr>
                <th>Mã KH</th>
                <th>Họ và Tên</th>
                <th>Số điện thoại</th>
                <th>Email</th>
                <th>Địa chỉ</th>
                <th style="text-align: center;">Đơn hàng</th>
                <th>Trạng thái</th>
                <th style="text-align: center;">Hành động</th>
            </tr>
        </thead>
        <tbody>
            @if (Model == null || !Model.Any())
            {
                <tr>
                    <td colspan="8" style="text-align: center; color: var(--text-muted); padding: 3rem 1.25rem;">
                        <i class="fas fa-user-slash" style="font-size: 2.5rem; color: var(--text-light); margin-bottom: 1rem; display: block;"></i>
                        Không tìm thấy khách hàng nào trong hệ thống.
                    </td>
                </tr>
            }
            else
            {
                @foreach (var customer in Model)
                {
                    bool isLocked = customer.User != null && customer.User.LockoutEnd > DateTimeOffset.UtcNow;
                    <tr>
                        <td style="font-family: monospace; font-weight: 600; color: var(--text-muted);">@customer.MaKhachHang</td>
                        <td style="font-weight: 700; color: var(--text-main);">@customer.HoTen</td>
                        <td style="font-weight: 600; color: var(--accent-primary);">@customer.SoDienThoai</td>
                        <td>@(string.IsNullOrEmpty(customer.Email) ? "N/A" : customer.Email)</td>
                        <td style="max-width: 250px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;" title="@customer.DiaChi">
                            @(string.IsNullOrEmpty(customer.DiaChi) ? "Chưa cập nhật" : customer.DiaChi)
                        </td>
                        <td style="text-align: center; font-weight: 700;">
                            <span class="badge" style="background: rgba(37, 99, 235, 0.08); color: var(--primary); font-size: 0.8rem; padding: 0.25rem 0.6rem;">
                                @customer.DonHangs.Count
                            </span>
                        </td>
                        <td>
                            @if (customer.User == null)
                            {
                                <span class="badge" style="background: #f1f5f9; color: #64748b; border: 1px solid #cbd5e1;">Không có tài khoản</span>
                            }
                            else if (isLocked)
                            {
                                <span class="badge badge-error">Bị khóa</span>
                            }
                            else
                            {
                                <span class="badge badge-success">Hoạt động</span>
                            }
                        </td>
                        <td style="text-align: center; white-space: nowrap;">
                            <button class="glass" onclick="openDetailsModal('@customer.MaKhachHang')" style="padding: 0.55rem; border: 1px solid #e2e8f0; color: #0ea5e9; cursor: pointer; border-radius: 8px; margin-right: 0.25rem; background: rgba(14, 165, 233, 0.05);" title="Xem chi tiết & Lịch sử đơn hàng">
                                <i class="fas fa-eye"></i>
                            </button>
                            <button class="glass" onclick="openEditCustomerModal('@customer.MaKhachHang', '@customer.HoTen', '@customer.SoDienThoai', '@customer.Email', '@customer.DiaChi')" style="padding: 0.55rem; border: 1px solid #e2e8f0; color: #3b82f6; cursor: pointer; border-radius: 8px; margin-right: 0.25rem; background: rgba(59, 130, 246, 0.05);" title="Sửa thông tin">
                                <i class="fas fa-edit"></i>
                            </button>
                            @if (customer.User != null)
                            {
                                <form asp-action="ToggleCustomerStatus" method="post" style="display: inline;" onsubmit="return confirm('Bạn có chắc chắn muốn @(isLocked ? "mở khóa" : "khóa") tài khoản khách hàng này?')">
                                    <input type="hidden" name="id" value="@customer.MaKhachHang" />
                                    <button type="submit" class="glass" style="padding: 0.55rem; border: 1px solid #e2e8f0; color: @(isLocked ? "#10b981" : "#ef4444"); cursor: pointer; border-radius: 8px; background: @(isLocked ? "rgba(16, 185, 129, 0.05)" : "rgba(239, 68, 68, 0.05)");" title="@(isLocked ? "Mở khóa tài khoản" : "Khóa tài khoản")">
                                        <i class="fas @(isLocked ? "fa-user-check" : "fa-user-lock")"></i>
                                    </button>
                                </form>
                            }
                            else
                            {
                                <button class="glass" disabled style="padding: 0.55rem; border: 1px solid #e2e8f0; color: #cbd5e1; cursor: not-allowed; border-radius: 8px; background: rgba(241, 245, 249, 0.5);" title="Không có tài khoản người dùng">
                                    <i class="fas fa-user-lock" style="opacity: 0.4;"></i>
                                </button>
                            }
                            <form asp-action="DeleteCustomer" method="post" style="display: inline;" onsubmit="return confirm('Bạn có chắc chắn muốn xóa khách hàng này khỏi hệ thống?')">
                                <input type="hidden" name="id" value="@customer.MaKhachHang" />
                                <button type="submit" class="glass" style="padding: 0.55rem; border: 1px solid #e2e8f0; color: #ef4444; cursor: pointer; border-radius: 8px; background: rgba(239, 68, 68, 0.05);" title="Xóa khách hàng">
                                    <i class="fas fa-trash-alt"></i>
                                </button>
                            </form>
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div>

<!-- Modal Thêm Khách hàng Mới -->
<div id="add-customer-modal" style="display: none; position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(15, 23, 42, 0.6); z-index: 2000; align-items: center; justify-content: center; backdrop-filter: blur(4px);">
    <div class="glass animate-fade-in" style="width: 480px; padding: 2.5rem; position: relative; background: var(--card-bg, white); border-radius: 16px; box-shadow: var(--shadow-lg);">
        <button onclick="document.getElementById('add-customer-modal').style.display='none'" style="position: absolute; top: 1.5rem; right: 1.5rem; background: none; border: none; color: #64748b; cursor: pointer; font-size: 1.5rem; font-weight: bold;">&times;</button>
        <h3 style="margin-top: 0; margin-bottom: 2rem; font-weight: 800; font-size: 1.5rem; color: var(--text-main); display: flex; align-items: center; gap: 0.5rem;">
            <i class="fas fa-user-plus" style="color: var(--primary);"></i> Thêm Khách hàng mới
        </h3>
        <form asp-action="CreateCustomer" method="post">
            <div class="form-group" style="margin-bottom: 1.25rem;">
                <label style="display: block; font-size: 0.875rem; color: var(--text-muted); margin-bottom: 0.5rem; font-weight: 600;">Họ và Tên</label>
                <input name="hoTen" class="glass" style="width: 100%; padding: 0.875rem; border: 1px solid #e2e8f0; border-radius: 8px; box-sizing: border-box; font-weight: 600;" placeholder="Nhập họ và tên khách hàng" required />
            </div>
            
            <div class="form-group" style="margin-bottom: 1.25rem;">
                <label style="display: block; font-size: 0.875rem; color: var(--text-muted); margin-bottom: 0.5rem; font-weight: 600;">Số điện thoại</label>
                <input name="soDienThoai" class="glass" style="width: 100%; padding: 0.875rem; border: 1px solid #e2e8f0; border-radius: 8px; box-sizing: border-box; font-weight: 600;" placeholder="Ví dụ: 0912345678" required />
            </div>
            
            <div class="form-group" style="margin-bottom: 1.25rem;">
                <label style="display: block; font-size: 0.875rem; color: var(--text-muted); margin-bottom: 0.5rem; font-weight: 600;">Địa chỉ Email</label>
                <input name="email" type="email" class="glass" style="width: 100%; padding: 0.875rem; border: 1px solid #e2e8f0; border-radius: 8px; box-sizing: border-box;" placeholder="khachhang@email.com" />
            </div>
            
            <div class="form-group" style="margin-bottom: 1.25rem;">
                <label style="display: block; font-size: 0.875rem; color: var(--text-muted); margin-bottom: 0.5rem; font-weight: 600;">Địa chỉ nhận hàng</label>
                <textarea name="diaChi" class="glass" style="width: 100%; padding: 0.875rem; border: 1px solid #e2e8f0; border-radius: 8px; box-sizing: border-box; min-height: 60px; font-family: inherit; resize: vertical;" placeholder="Địa chỉ giao hàng mặc định"></textarea>
            </div>

            <div class="form-group" style="margin-bottom: 2rem;">
                <label style="display: block; font-size: 0.875rem; color: var(--text-muted); margin-bottom: 0.5rem; font-weight: 600;">Mật khẩu đăng nhập</label>
                <input name="password" type="password" class="glass" style="width: 100%; padding: 0.875rem; border: 1px solid #e2e8f0; border-radius: 8px; box-sizing: border-box;" placeholder="Mặc định: Customer@123 nếu để trống" />
                <span style="font-size: 0.75rem; color: var(--text-muted); display: block; margin-top: 0.25rem;"><i class="fas fa-info-circle"></i> Mật khẩu cần tối thiểu 6 ký tự, chứa chữ hoa, chữ thường và ký tự đặc biệt.</span>
            </div>
            
            <div style="display: flex; gap: 0.75rem;">
                <button type="button" onclick="document.getElementById('add-customer-modal').style.display='none'" class="btn-premium btn-secondary-premium" style="flex: 1; padding: 0.875rem;">Hủy</button>
                <button type="submit" class="btn-premium" style="flex: 1; padding: 0.875rem;">Thêm mới</button>
            </div>
        </form>
    </div>
</div>

<!-- Modal Sửa Thông tin Khách hàng -->
<div id="edit-customer-modal" style="display: none; position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(15, 23, 42, 0.6); z-index: 2000; align-items: center; justify-content: center; backdrop-filter: blur(4px);">
    <div class="glass animate-fade-in" style="width: 480px; padding: 2.5rem; position: relative; background: var(--card-bg, white); border-radius: 16px; box-shadow: var(--shadow-lg);">
        <button onclick="document.getElementById('edit-customer-modal').style.display='none'" style="position: absolute; top: 1.5rem; right: 1.5rem; background: none; border: none; color: #64748b; cursor: pointer; font-size: 1.5rem; font-weight: bold;">&times;</button>
        <h3 style="margin-top: 0; margin-bottom: 2rem; font-weight: 800; font-size: 1.5rem; color: var(--text-main); display: flex; align-items: center; gap: 0.5rem;">
            <i class="fas fa-user-edit" style="color: var(--primary);"></i> Chỉnh sửa Khách hàng
        </h3>
        <form asp-action="EditCustomer" method="post">
            <input type="hidden" name="maKhachHang" id="edit-customer-id" />
            
            <div class="form-group" style="margin-bottom: 1.25rem;">
                <label style="display: block; font-size: 0.875rem; color: var(--text-muted); margin-bottom: 0.5rem; font-weight: 600;">Họ và Tên</label>
                <input name="hoTen" id="edit-customer-name" class="glass" style="width: 100%; padding: 0.875rem; border: 1px solid #e2e8f0; border-radius: 8px; box-sizing: border-box; font-weight: 600;" required />
            </div>
            
            <div class="form-group" style="margin-bottom: 1.25rem;">
                <label style="display: block; font-size: 0.875rem; color: var(--text-muted); margin-bottom: 0.5rem; font-weight: 600;">Số điện thoại</label>
                <input name="soDienThoai" id="edit-customer-phone" class="glass" style="width: 100%; padding: 0.875rem; border: 1px solid #e2e8f0; border-radius: 8px; box-sizing: border-box; font-weight: 600;" placeholder="Ví dụ: 0912345678" required />
            </div>
            
            <div class="form-group" style="margin-bottom: 1.25rem;">
                <label style="display: block; font-size: 0.875rem; color: var(--text-muted); margin-bottom: 0.5rem; font-weight: 600;">Địa chỉ Email</label>
                <input name="email" id="edit-customer-email" type="email" class="glass" style="width: 100%; padding: 0.875rem; border: 1px solid #e2e8f0; border-radius: 8px; box-sizing: border-box;" placeholder="khachhang@email.com" />
            </div>
            
            <div class="form-group" style="margin-bottom: 2rem;">
                <label style="display: block; font-size: 0.875rem; color: var(--text-muted); margin-bottom: 0.5rem; font-weight: 600;">Địa chỉ nhận hàng</label>
                <textarea name="diaChi" id="edit-customer-address" class="glass" style="width: 100%; padding: 0.875rem; border: 1px solid #e2e8f0; border-radius: 8px; box-sizing: border-box; min-height: 80px; font-family: inherit; resize: vertical;" placeholder="Địa chỉ giao hàng mặc định của khách hàng"></textarea>
            </div>
            
            <div style="display: flex; gap: 0.75rem;">
                <button type="button" onclick="document.getElementById('edit-customer-modal').style.display='none'" class="btn-premium btn-secondary-premium" style="flex: 1; padding: 0.875rem;">Hủy</button>
                <button type="submit" class="btn-premium" style="flex: 1; padding: 0.875rem;">Lưu thông tin</button>
            </div>
        </form>
    </div>
</div>

<!-- Modal Chi Tiết Khách Hàng & Lịch Sử Đơn Hàng -->
<div id="details-customer-modal" style="display: none; position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(15, 23, 42, 0.4); z-index: 2000; align-items: center; justify-content: center; backdrop-filter: blur(8px);">
    <div class="glass animate-fade-in" style="width: 860px; max-width: 95%; max-height: 90vh; padding: 2.25rem; position: relative; background: rgba(255, 255, 255, 0.92); border-radius: 20px; box-shadow: 0 30px 60px rgba(15, 23, 42, 0.15); border: 1px solid rgba(255, 255, 255, 0.8); display: flex; flex-direction: column; overflow: hidden; border-top: 5px solid var(--primary);">
        <button onclick="document.getElementById('details-customer-modal').style.display='none'" style="position: absolute; top: 1.25rem; right: 1.25rem; background: rgba(15, 23, 42, 0.05); border: none; color: #64748b; cursor: pointer; font-size: 1.25rem; width: 36px; height: 36px; border-radius: 50%; display: flex; align-items: center; justify-content: center; transition: all 0.2s;" onmouseover="this.style.background='rgba(239, 68, 68, 0.1)'; this.style.color='#ef4444';" onmouseout="this.style.background='rgba(15, 23, 42, 0.05)'; this.style.color='#64748b';">&times;</button>
        
        <h3 style="margin-top: 0; margin-bottom: 1.5rem; font-weight: 800; font-size: 1.5rem; color: var(--text-main); display: flex; align-items: center; gap: 0.5rem; flex-shrink: 0;">
            <i class="fas fa-id-card" style="color: var(--primary);"></i> Chi tiết Hồ sơ Khách hàng
        </h3>
        
        <div style="display: flex; flex-direction: column; gap: 1.5rem; overflow-y: auto; flex: 1; padding-right: 0.5rem;">
            
            <!-- Customer profile details section -->
            <div style="display: flex; gap: 1.75rem; align-items: center; background: linear-gradient(135deg, rgba(37, 99, 235, 0.04) 0%, rgba(6, 182, 212, 0.04) 100%); border: 1px solid rgba(37, 99, 235, 0.15); padding: 1.75rem; border-radius: 16px; margin-bottom: 0.5rem; flex-wrap: wrap;">
                <!-- Avatar with initials -->
                <div style="width: 80px; height: 80px; background: linear-gradient(135deg, var(--primary) 0%, var(--cyan-accent) 100%); border-radius: 50%; display: flex; align-items: center; justify-content: center; color: white; font-size: 2rem; font-weight: 800; box-shadow: 0 10px 25px rgba(37, 99, 235, 0.25); flex-shrink: 0;" id="detail-customer-avatar-box">
                    <span id="detail-customer-avatar-text">KH</span>
                </div>
                
                <!-- Profile Metadata Grid -->
                <div style="flex: 1; display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 1.25rem;">
                    <div>
                        <span style="font-size: 0.725rem; color: var(--text-light); text-transform: uppercase; font-weight: 800; letter-spacing: 0.05em; display: block; margin-bottom: 0.25rem;">Mã khách hàng</span>
                        <span id="detail-customer-id" style="font-family: monospace; font-size: 1.05rem; font-weight: 700; color: var(--text-main);">KH_TEST_01</span>
                    </div>
                    <div>
                        <span style="font-size: 0.725rem; color: var(--text-light); text-transform: uppercase; font-weight: 800; letter-spacing: 0.05em; display: block; margin-bottom: 0.25rem;">Họ và Tên</span>
                        <span id="detail-customer-name" style="font-size: 1.1rem; font-weight: 800; color: var(--text-main);">Lê Thị Khách Hàng</span>
                    </div>
                    <div>
                        <span style="font-size: 0.725rem; color: var(--text-light); text-transform: uppercase; font-weight: 800; letter-spacing: 0.05em; display: block; margin-bottom: 0.25rem;">Số điện thoại</span>
                        <span id="detail-customer-phone" style="font-size: 1.05rem; font-weight: 700; color: var(--accent-primary);">0912345678</span>
                    </div>
                    <div>
                        <span style="font-size: 0.725rem; color: var(--text-light); text-transform: uppercase; font-weight: 800; letter-spacing: 0.05em; display: block; margin-bottom: 0.25rem;">Email</span>
                        <span id="detail-customer-email" style="font-size: 1.05rem; font-weight: 700; color: var(--text-main); word-break: break-all;">customer@sdms.com</span>
                    </div>
                    <div style="grid-column: 1 / -1;">
                        <span style="font-size: 0.725rem; color: var(--text-light); text-transform: uppercase; font-weight: 800; letter-spacing: 0.05em; display: block; margin-bottom: 0.25rem;">Địa chỉ mặc định</span>
                        <span id="detail-customer-address" style="font-size: 1rem; font-weight: 600; color: var(--text-muted);">456 Nguyễn Huệ, Quận 1, TP. HCM</span>
                    </div>
                    <div style="display: flex; align-items: center; gap: 1.5rem; grid-column: 1 / -1; margin-top: 0.25rem; border-top: 1px dashed rgba(37, 99, 235, 0.15); padding-top: 0.75rem;">
                        <div>
                            <span style="font-size: 0.725rem; color: var(--text-light); text-transform: uppercase; font-weight: 800; letter-spacing: 0.05em; display: inline-block; margin-right: 0.5rem;">Trạng thái:</span>
                            <span id="detail-customer-status" class="badge badge-success">Hoạt động</span>
                        </div>
                        <div>
                            <span style="font-size: 0.725rem; color: var(--text-light); text-transform: uppercase; font-weight: 800; letter-spacing: 0.05em; display: inline-block; margin-right: 0.5rem;">Tổng đơn gửi:</span>
                            <span id="detail-customer-ordercount" class="badge" style="background: rgba(255, 107, 53, 0.1); color: var(--secondary); border: 1px solid rgba(255, 107, 53, 0.2);">12 đơn</span>
                        </div>
                    </div>
                </div>
            </div>
            
            <!-- Order history section -->
            <div>
                <h4 style="font-size: 1.15rem; font-weight: 800; color: var(--text-main); margin-top: 0.75rem; margin-bottom: 0.75rem; display: flex; align-items: center; gap: 0.5rem;">
                    <i class="fas fa-history" style="color: var(--secondary); font-size: 1rem;"></i> Lịch sử đơn hàng đã gửi
                </h4>
                
                <div id="order-loader" style="text-align: center; padding: 3rem 0; display: none;">
                    <i class="fas fa-spinner fa-spin" style="font-size: 2rem; color: var(--primary);"></i>
                    <p style="color: var(--text-muted); font-size: 0.875rem; margin-top: 0.5rem;">Đang tải danh sách đơn hàng...</p>
                </div>
                
                <div id="order-history-container" style="max-height: 250px; overflow-y: auto; border: 1px solid rgba(37, 99, 235, 0.12); border-radius: 12px; box-shadow: inset 0 2px 4px rgba(0, 0, 0, 0.01); background: white;">
                    <table class="premium-table" style="margin: 0; min-width: 100%;">
                        <thead style="position: sticky; top: 0; z-index: 5;">
                            <tr>
                                <th style="padding: 0.9rem 1.1rem; font-size: 0.75rem; background: #f8fafc; border-bottom: 2px solid rgba(37, 99, 235, 0.15);">Mã đơn</th>
                                <th style="padding: 0.9rem 1.1rem; font-size: 0.75rem; background: #f8fafc; border-bottom: 2px solid rgba(37, 99, 235, 0.15);">Thời gian tạo</th>
                                <th style="padding: 0.9rem 1.1rem; font-size: 0.75rem; background: #f8fafc; border-bottom: 2px solid rgba(37, 99, 235, 0.15); text-align: center;">Ngày nhận dự kiến</th>
                                <th style="padding: 0.9rem 1.1rem; font-size: 0.75rem; background: #f8fafc; border-bottom: 2px solid rgba(37, 99, 235, 0.15); text-align: center;">Khối lượng</th>
                                <th style="padding: 0.9rem 1.1rem; font-size: 0.75rem; background: #f8fafc; border-bottom: 2px solid rgba(37, 99, 235, 0.15); text-align: right;">Phí giao hàng</th>
                                <th style="padding: 0.9rem 1.1rem; font-size: 0.75rem; background: #f8fafc; border-bottom: 2px solid rgba(37, 99, 235, 0.15); text-align: center;">Trạng thái</th>
                            </tr>
                        </thead>
                        <tbody id="detail-orders-list">
                            <!-- Populated dynamically via JS -->
                        </tbody>
                    </table>
                </div>
            </div>
            
        </div>
        
        <div style="margin-top: 1.5rem; text-align: right; flex-shrink: 0; border-top: 1px solid var(--border-color); padding-top: 1.25rem;">
            <button onclick="document.getElementById('details-customer-modal').style.display='none'" class="btn-premium" style="padding: 0.75rem 2rem; font-weight: bold; border-radius: 10px; background: linear-gradient(135deg, var(--primary) 0%, var(--primary-light) 100%); box-shadow: 0 8px 20px rgba(37, 99, 235, 0.25);">Đóng chi tiết</button>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function openEditCustomerModal(id, name, phone, email, address) {
            document.getElementById('edit-customer-id').value = id;
            document.getElementById('edit-customer-name').value = name;
            document.getElementById('edit-customer-phone').value = phone;
            document.getElementById('edit-customer-email').value = email || '';
            document.getElementById('edit-customer-address').value = address || '';
            document.getElementById('edit-customer-modal').style.display = 'flex';
        }

        function openDetailsModal(id) {
            const modal = document.getElementById('details-customer-modal');
            const loader = document.getElementById('order-loader');
            const historyContainer = document.getElementById('order-history-container');
            const ordersList = document.getElementById('detail-orders-list');
            
            // Open modal and show spinner
            ordersList.innerHTML = '';
            historyContainer.style.display = 'none';
            loader.style.display = 'block';
            modal.style.display = 'flex';

            // Fetch customer details via AJAX
            $.ajax({
                url: '@Url.Action("GetCustomerDetails", "Admin")',
                type: 'GET',
                data: { id: id },
                dataType: 'json',
                success: function(data) {
                    // Populate customer fields
                    document.getElementById('detail-customer-id').innerText = data.maKhachHang;
                    document.getElementById('detail-customer-name').innerText = data.hoTen;
                    document.getElementById('detail-customer-phone').innerText = data.soDienThoai;
                    document.getElementById('detail-customer-email').innerText = data.email || 'N/A';
                    document.getElementById('detail-customer-address').innerText = data.diaChi || 'Chưa cập nhật';
                    document.getElementById('detail-customer-ordercount').innerText = data.orders.length + ' đơn hàng';
                    
                    // Render avatar initials
                    const avatarChar = data.hoTen ? data.hoTen.trim().charAt(0).toUpperCase() : 'K';
                    document.getElementById('detail-customer-avatar-text').innerText = avatarChar;

                    // Render status badge
                    const statusBadge = document.getElementById('detail-customer-status');
                    statusBadge.className = 'badge';
                    if (!data.hasUser) {
                        statusBadge.classList.add('badge-info');
                        statusBadge.innerText = 'Không có tài khoản';
                        statusBadge.style.background = '#f1f5f9';
                        statusBadge.style.color = '#64748b';
                        statusBadge.style.border = '1px solid #cbd5e1';
                    } else if (data.isLocked) {
                        statusBadge.classList.add('badge-error');
                        statusBadge.innerText = 'Bị khóa';
                        statusBadge.style.background = '';
                        statusBadge.style.color = '';
                        statusBadge.style.border = '';
                    } else {
                        statusBadge.classList.add('badge-success');
                        statusBadge.innerText = 'Hoạt động';
                        statusBadge.style.background = '';
                        statusBadge.style.color = '';
                        statusBadge.style.border = '';
                    }

                    // Render orders list
                    if (data.orders.length === 0) {
                        ordersList.innerHTML = `
                            <tr>
                                <td colspan="6" style="text-align: center; color: var(--text-muted); padding: 3rem 1rem;">
                                    <i class="fas fa-box-open" style="font-size: 1.5rem; color: var(--text-light); margin-bottom: 0.5rem; display: block;"></i>
                                    Khách hàng chưa gửi đơn hàng nào.
                                </td>
                            </tr>
                        `;
                    } else {
                        data.orders.forEach(function(order) {
                            let badgeClass = 'badge-info';
                            if (order.trangThaiDonHang === 'Đã hoàn thành') {
                                badgeClass = 'badge-success';
                            } else if (order.trangThaiDonHang === 'Giao hàng thất bại') {
                                badgeClass = 'badge-error';
                            } else if (order.trangThaiDonHang === 'Đang giao') {
                                badgeClass = 'badge-warning';
                            } else if (order.trangThaiDonHang === 'Đã nhập kho') {
                                badgeClass = 'badge-info';
                            }

                            ordersList.innerHTML += `
                                <tr style="transition: background-color 0.2s;">
                                    <td style="font-family: monospace; font-weight: 700; padding: 0.9rem 1.1rem; color: var(--text-main); font-size: 0.9rem;">${order.maDonHang}</td>
                                    <td style="padding: 0.9rem 1.1rem; color: var(--text-muted); font-size: 0.85rem;">${order.thoiGianTao}</td>
                                    <td style="text-align: center; color: var(--text-main); font-size: 0.85rem; padding: 0.9rem 1.1rem; font-weight: 600;">
                                        <i class="far fa-calendar-alt" style="color: var(--text-light); margin-right: 0.25rem;"></i> ${order.ngayGiaoDuKien}
                                    </td>
                                    <td style="text-align: center; font-weight: 600; padding: 0.9rem 1.1rem;">${order.tongKhoiLuong} kg</td>
                                    <td style="text-align: right; font-weight: 800; color: var(--secondary); padding: 0.9rem 1.1rem; font-size: 0.9rem;">${order.phiGiaoHang}</td>
                                    <td style="text-align: center; padding: 0.9rem 1.1rem;">
                                        <span class="badge ${badgeClass}" style="font-size: 0.7rem; padding: 0.2rem 0.6rem; text-transform: uppercase;">${order.trangThaiDonHang}</span>
                                    </td>
                                </tr>
                            `;
                        });
                    }

                    // Toggle visibility
                    loader.style.display = 'none';
                    historyContainer.style.display = 'block';
                },
                error: function() {
                    ordersList.innerHTML = `
                        <tr>
                            <td colspan="6" style="text-align: center; color: var(--text-muted); padding: 3rem 1rem;">
                                <i class="fas fa-exclamation-triangle" style="font-size: 1.5rem; color: var(--text-light); margin-bottom: 0.5rem; display: block;"></i>
                                Có lỗi xảy ra khi tải lịch sử đơn hàng.
                            </td>
                        </tr>
                    `;
                    loader.style.display = 'none';
                    historyContainer.style.display = 'block';
                }
            });
        }
    </script>
}

<style>
    /* CSS animation definitions */
    @@keyframes fadeIn {
        from { opacity: 0; transform: scale(0.96) translateY(5px); }
        to { opacity: 1; transform: scale(1) translateY(0); }
    }
    
    .animate-fade-in {
        animation: fadeIn 0.25s cubic-bezier(0.4, 0, 0.2, 1) forwards;
    }
</style>
