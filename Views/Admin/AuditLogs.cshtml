@model IEnumerable<SDMS.Models.NhatKyHeThong>
@{
    ViewData["Title"] = "Lịch sử tác động Hệ thống";
}

<div class="glass" style="padding: 2rem;">
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 2.5rem;">
        <h2 style="font-size: 1.75rem; font-weight: 800; margin: 0; color: var(--text-main);">Nhật ký Vận hành</h2>
        <div style="display: flex; gap: 1rem;">
            <input type="date" class="glass" style="padding: 0.75rem; border: 1px solid var(--border-color); border-radius: 8px; color: var(--text-main); background: var(--card-bg);" />
            <button class="btn-premium">Lọc dữ liệu</button>
        </div>
    </div>

    <table class="premium-table">
        <thead>
            <tr>
                <th>Mã Nhật ký</th>
                <th>Nhân viên</th>
                <th>Thao tác</th>
                <th>Đối tượng / Dữ liệu</th>
                <th>Thời điểm</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var log in Model)
            {
                <tr>
                    <td style="font-family: monospace; font-size: 0.8125rem; color: var(--text-muted);">@log.MaNhatKy</td>
                    <td style="font-weight: 700;">@log.NhanVien?.HoTen</td>
                    <td>
                        <span class="badge" style="background: rgba(79, 70, 229, 0.1); color: #4f46e5; padding: 0.4rem 1rem; border: 1px solid rgba(79, 70, 229, 0.2);">
                            @log.HanhDong
                        </span>
                    </td>
                    <td style="color: var(--text-muted);">@log.DuLieuTacDong</td>
                    <td style="font-size: 0.875rem;">@log.ThoiGian.ToString("dd/MM/yyyy HH:mm:ss")</td>
                </tr>
            }
        </tbody>
    </table>
</div>
