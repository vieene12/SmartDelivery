@model IEnumerable<SDMS.Models.NhatKyHeThong>
@{
    ViewData["Title"] = "Quản trị Hệ thống";
}

@functions {
    public string GetActionBadgeClass(string action)
    {
        if (string.IsNullOrEmpty(action)) return "background: rgba(139, 92, 246, 0.08); color: #8b5cf6; border: 1px solid rgba(139, 92, 246, 0.15);";
        if (action.Contains("Thêm") || action.Contains("Tạo") || action.Contains("Nhập"))
            return "background: rgba(16, 185, 129, 0.08); color: #10b981; border: 1px solid rgba(16, 185, 129, 0.15);";
        if (action.Contains("Sửa") || action.Contains("Cập nhật") || action.Contains("Thay đổi"))
            return "background: rgba(37, 99, 235, 0.08); color: var(--primary); border: 1px solid rgba(37, 99, 235, 0.15);";
        if (action.Contains("Xóa") || action.Contains("Hủy") || action.Contains("Bảo trì"))
            return "background: rgba(239, 68, 68, 0.08); color: #ef4444; border: 1px solid rgba(239, 68, 68, 0.15);";
        return "background: rgba(139, 92, 246, 0.08); color: #8b5cf6; border: 1px solid rgba(139, 92, 246, 0.15);";
    }

    public string GetActionIcon(string action)
    {
        if (string.IsNullOrEmpty(action)) return "fa-cog";
        if (action.Contains("Thêm") || action.Contains("Tạo") || action.Contains("Nhập"))
            return "fa-plus-circle";
        if (action.Contains("Sửa") || action.Contains("Cập nhật") || action.Contains("Thay đổi"))
            return "fa-edit";
        if (action.Contains("Xóa") || action.Contains("Hủy") || action.Contains("Bảo trì"))
            return "fa-trash-alt";
        return "fa-cog";
    }
}

<!-- Welcome Banner Cockpit -->
<div class="dashboard-welcome-banner glass" style="padding: 2.25rem 2.5rem; border-radius: var(--radius-lg); margin-bottom: 2.5rem; position: relative; overflow: hidden; border-color: rgba(37, 99, 235, 0.15); background: linear-gradient(135deg, rgba(37, 99, 235, 0.05), rgba(6, 182, 212, 0.05));">
    <div style="position: absolute; top: 0; left: 0; width: 6px; height: 100%; background: linear-gradient(to bottom, var(--primary), var(--cyan-accent));"></div>
    <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 1.5rem;">
        <div>
            <h1 style="font-size: 1.85rem; font-weight: 900; color: var(--text-main); margin: 0; letter-spacing: -0.03em;">Bảng Điều Khiển Quản Trị</h1>
            <p style="font-size: 0.95rem; color: var(--text-muted); margin: 0.5rem 0 0; font-weight: 550;">Chào mừng trở lại! Hệ thống SmartDelivery đang hoạt động ổn định và hiệu quả.</p>
        </div>
        <div style="display: flex; gap: 0.75rem; flex-wrap: wrap;">
            <a asp-controller="Admin" asp-action="Staff" class="btn-premium" style="padding: 0.7rem 1.35rem; text-decoration: none; font-size: 0.85rem; display: inline-flex; align-items: center; gap: 0.5rem;"><i class="fas fa-users-cog"></i> Quản lý Nhân sự</a>
            <a asp-controller="Admin" asp-action="Warehouses" class="btn-premium btn-secondary-premium" style="padding: 0.7rem 1.35rem; text-decoration: none; font-size: 0.85rem; display: inline-flex; align-items: center; gap: 0.5rem;"><i class="fas fa-warehouse"></i> Quản lý Kho bãi</a>
        </div>
    </div>
</div>

<!-- Stats Grid -->
<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 1.5rem; margin-bottom: 2.5rem;">
    <div class="glass stat-card">
        <div class="stat-card-icon" style="color: #10b981; background: rgba(16, 185, 129, 0.08);">
            <i class="fas fa-wallet"></i>
        </div>
        <span class="stat-label">Doanh thu thu hộ (COD)</span>
        <span class="stat-value">@string.Format("{0:N0} VNĐ", ViewBag.Stats.TotalRevenue)</span>
        <div style="color: #10b981; font-size: 0.8125rem; font-weight: 600; margin-top: 0.5rem;"><i class="fas fa-check-circle"></i> Tổng tiền mặt đã thu</div>
    </div>
    <div class="glass stat-card">
        <div class="stat-card-icon" style="color: var(--primary); background: rgba(37, 99, 235, 0.08);">
            <i class="fas fa-percent"></i>
        </div>
        <span class="stat-label">Tỷ lệ Giao thành công</span>
        <span class="stat-value">@ViewBag.Stats.SuccessRate%</span>
        <div style="width: 100%; height: 6px; background: var(--border-color); border-radius: 10px; overflow: hidden; margin-top: 0.75rem;">
            <div style="width: @ViewBag.Stats.SuccessRate%; height: 100%; background: var(--primary); border-radius: 10px;"></div>
        </div>
    </div>
    <div class="glass stat-card">
        <div class="stat-card-icon" style="color: var(--cyan-accent); background: rgba(6, 182, 212, 0.08);">
            <i class="fas fa-user-check"></i>
        </div>
        <span class="stat-label">Shipper đang hoạt động</span>
        <span class="stat-value">@ViewBag.Stats.ActiveShippers</span>
        <div style="color: var(--text-muted); font-size: 0.8125rem; font-weight: 600; margin-top: 0.5rem;"><i class="fas fa-shipping-fast"></i> Đang trong ca làm việc</div>
    </div>
    <div class="glass stat-card">
        <div class="stat-card-icon" style="color: #ef4444; background: rgba(239, 68, 68, 0.08);">
            <i class="fas fa-exclamation-triangle"></i>
        </div>
        <span class="stat-label">Đơn hàng tồn kho</span>
        <span class="stat-value">@ViewBag.Stats.PendingBacklog</span>
        <div style="color: #ef4444; font-size: 0.8125rem; font-weight: 600; margin-top: 0.5rem;"><i class="fas fa-exclamation-circle"></i> Cần xử lý điều phối</div>
    </div>
</div>

<!-- Activity Log Panel -->
<div class="glass" style="padding: 2rem; border-radius: var(--radius-md);">
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 2rem; flex-wrap: wrap; gap: 1rem;">
        <div>
            <h2 style="font-size: 1.5rem; font-weight: 850; margin: 0; color: var(--text-main); letter-spacing: -0.02em;">Nhật ký Hoạt động Hệ thống</h2>
            <p style="font-size: 0.85rem; color: var(--text-muted); margin: 0.25rem 0 0; font-weight: 550;">Ghi nhận tất cả các tác vụ quản trị cốt lõi thời gian thực</p>
        </div>
        <a asp-action="AuditLogs" class="btn-premium btn-secondary-premium" style="text-decoration: none; font-size: 0.85rem; padding: 0.65rem 1.25rem;">Xem toàn bộ lịch sử <i class="fas fa-arrow-right" style="margin-left: 0.25rem; font-size: 0.75rem;"></i></a>
    </div>
    
    <div style="overflow-x: auto;">
        <table class="premium-table">
            <thead>
                <tr>
                    <th>Thời gian</th>
                    <th>Người thực hiện</th>
                    <th>Hành động</th>
                    <th>Chi tiết tác động</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var log in Model)
                {
                    <tr>
                        <td style="font-size: 0.85rem; color: var(--text-muted); font-weight: 550;">@log.ThoiGian.ToString("dd/MM/yyyy HH:mm:ss")</td>
                        <td style="font-weight: 700; color: var(--text-main);">@log.NhanVien?.HoTen</td>
                        <td>
                            <span class="badge" style="padding: 0.4rem 0.8rem; border-radius: 6px; font-weight: 750; font-size: 0.775rem; display: inline-flex; align-items: center; gap: 0.35rem; @GetActionBadgeClass(log.HanhDong)">
                                <i class="fas @GetActionIcon(log.HanhDong)"></i> @log.HanhDong
                            </span>
                        </td>
                        <td style="color: var(--text-muted); font-size: 0.9rem; font-weight: 550;">@log.DuLieuTacDong</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

